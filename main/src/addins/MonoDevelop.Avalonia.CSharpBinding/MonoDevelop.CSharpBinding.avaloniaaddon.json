{
  "identity": {
    "id": "MonoDevelop.CSharpBinding",
    "displayName": "C# Binding",
    "name": "CSharpBinding",
    "publisher": "MonoDevelop",
    "version": "9.0.0",
    "description": "C# coding standards and behavior options (Avalonia add-in)."
  },
  "assetType": "Microsoft.VisualStudio.MefComponent",
  "installationTarget": { "id": "MonoDevelop.Avalonia", "version": "9.0" },
  "tags": [ "csharp", "binding", "behavior", "analysis" ],
  "categories": [ "Text Editor" ],
  "dependencies": [ { "id": "MonoDevelop.Ide", "versionRange": "[9.0,*)" } ],
  "autoLoad": true,
  "extensions": {
    "/MonoDevelop/Ide/GlobalOptionsDialog/TextEditor/Behavior": [
      { "id": "CSharpOnTheFlyFormattingPanel", "label": "C#", "icon": "md-prefs-code-formatting", "className": "MonoDevelop.SourceEditor.OptionPanels.OnTheFlyFormattingPanel" }
    ],
    "/MonoDevelop/Ide/GlobalOptionsDialog/TextEditor/Analysis/C#": [
      { "id": "CodeStylePanel", "label": "Code Style", "icon": "md-prefs-code-rules", "className": "MonoDevelop.CSharp.OptionProvider.CodeStylePage" }
    ]
  }
}