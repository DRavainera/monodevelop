{
  "identity": {
    "id": "MonoDevelop.VersionControl",
    "name": "Version Control",
    "publisher": "MonoDevelop",
    "version": "9.0.0",
    "description": "Version control options: commit message style, per-VCS settings (Avalonia add-in)."
  },
  "assetType": "Microsoft.VisualStudio.MefComponent",
