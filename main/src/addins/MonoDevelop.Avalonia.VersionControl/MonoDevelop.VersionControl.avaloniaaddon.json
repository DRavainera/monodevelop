  "dependencies": [ { "id": "MonoDevelop.Ide", "version": "9.0" } ],
  "autoLoad": true,
  "extensions": {
    "/MonoDevelop/Ide/GlobalOptionsDialog/VersionControl": [
      { "id": "General", "label": "General", "icon": "md-prefs-version-control" },
      { "id": "Commit Message Style", "label": "Commit Message Style", "icon": "md-prefs-solution" },
      { "id": "Git", "label": "Git", "icon": "md-prefs-solution" },
      { "id": "ChangeLog Integration", "label": "ChangeLog Integration", "icon": "md-prefs-generic" }
    ]
