{
  "identity": {
    "id": "MonoDevelop.Refactoring",
    "name": "Refactoring Support",
    "publisher": "MonoDevelop",
    "version": "9.0.0",
    "description": "Source analysis and refactoring options (Avalonia add-in)."
  },
  "assetType": "Microsoft.VisualStudio.MefComponent",
  "installationTarget": {
    "id": "MonoDevelop.Avalonia",
    "version": "9.0"
  },
  "tags": [
    "refactoring",
    "code analysis",
    "source analysis"
  ],
  "categories": [
    "Text Editor"
  ],
  "dependencies": [
    {
      "id": "MonoDevelop.Ide",
      "version": "9.0"
    }
  ],
  "autoLoad": true,
  "extensions": {
    "/MonoDevelop/Ide/GlobalOptionsDialog/TextEditor": [
      {
        "id": "Analysis",
        "label": "Source Analysis",
        "icon": "md-prefs-code-analysis",
        "className": "MonoDevelop.AnalysisCore.Gui.AnalysisOptionsPanel"
      }
    ],
    "/MonoDevelop/Ide/GlobalOptionsDialog/TextEditor/Analysis/C#": [
      {
        "id": "CodeActions",
        "label": "Code Actions",
        "icon": "md-prefs-code-actions",
        "className": "MonoDevelop.CodeActions.CodeActionPanel"
      },
      {
        "id": "CodeGeneration",
        "label": "Code Generation",
        "icon": "md-prefs-generic",
        "className": "MonoDevelop.Refactoring.CodeGenerationPanel"
      },
      {
        "id": "CodeRules",
        "label": "Code Rules",
        "icon": "md-prefs-code-rules",
        "className": "MonoDevelop.CodeIssues.CodeRulePanel"
      }
    ]
  }
}