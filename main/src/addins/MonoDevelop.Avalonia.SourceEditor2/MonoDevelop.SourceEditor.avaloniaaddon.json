{
  "identity": {
    "id": "MonoDevelop.SourceEditor",
    "name": "Source Editor",
    "publisher": "MonoDevelop",
    "version": "9.0.0",
    "description": "Text editor options: general, markers, behavior, IntelliSense and color theme (Avalonia add-in).",
    "icon": "core:file-source-32.png"
  },
  "assetType": "Microsoft.VisualStudio.MefComponent",
  "installationTarget": { "id": "MonoDevelop.Avalonia", "version": "9.0" },
  "tags": [ "text editor", "source editor", "intellisense", "color theme" ],
  "categories": [ "Text Editor" ],
  "dependencies": [ { "id": "MonoDevelop.Ide", "version": "9.0" } ],
  "autoLoad": true,
  "extensions": {
    "/MonoDevelop/Ide/GlobalOptionsDialog/TextEditor": [
      { "id": "General", "label": "General", "icon": "md-prefs-text-editor-general", "className": "MonoDevelop.SourceEditor.OptionPanels.GeneralOptionsPanel" },
      { "id": "Markers", "label": "Markers and Rulers", "icon": "md-prefs-markers-rulers", "className": "MonoDevelop.SourceEditor.OptionPanels.MarkerPanel" },
      { "id": "Behavior", "label": "Behavior", "icon": "md-prefs-text-editor-behavior", "className": "MonoDevelop.SourceEditor.OptionPanels.BehaviorPanel" },
      { "id": "CodeCompletion", "label": "IntelliSense", "icon": "md-prefs-completion" },
      { "id": "CompletionBehavior", "label": "Behavior", "icon": "md-prefs-completion", "className": "MonoDevelop.SourceEditor.OptionPanels.CompletionOptionsPanel", "childId": "CodeCompletion" },
      { "id": "CompletionAppearance", "label": "Appearance", "icon": "md-prefs-completion", "className": "MonoDevelop.SourceEditor.OptionPanels.CompletionAppearancePanel", "childId": "CodeCompletion" },
      { "id": "SyntaxHighlighting", "label": "Color Theme", "icon": "md-prefs-syntax-highlighting", "className": "MonoDevelop.SourceEditor.OptionPanels.HighlightingPanel" }
    ]
  }
}