      { "id": "Behavior", "label": "Behavior", "icon": "md-prefs-text-editor-behavior" },
      { "id": "CodeCompletion", "label": "IntelliSense", "icon": "md-prefs-completion", "childId": "CompletionBehavior" },
      { "id": "SyntaxHighlighting", "label": "Color Theme", "icon": "md-prefs-syntax-highlighting" }
