<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MonoDevelop.Avalonia.WindowsPlatform</AssemblyName>
    <RootNamespace>MonoDevelop.Avalonia.WindowsPlatform</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutDir>$(MSBuildProjectDirectory)/../../../build/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MonoDevelop.Core">
      <HintPath>../../../build/MonoDevelop.Core.dll</HintPath>
    </Reference>
    <Reference Include="MonoDevelop.Ide">
      <HintPath>../../../build/MonoDevelop.Ide.dll</HintPath>
    </Reference>
    <Reference Include="MonoDevelop.Avalonia.Addons">
      <HintPath>../../../build/MonoDevelop.Avalonia.Addons.dll</HintPath>
    </Reference>
    <Reference Include="Xwt">
      <HintPath>../../../build/Xwt.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
