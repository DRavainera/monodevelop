<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MonoDevelop.Avalonia.WindowsPlatform</AssemblyName>
    <RootNamespace>MonoDevelop.Avalonia.WindowsPlatform</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MonoDevelop.Core">
      <HintPath>../../build/bin/net10.0/MonoDevelop.Core.dll</HintPath>
    </Reference>
    <Reference Include="MonoDevelop.Avalonia.Addons">
      <HintPath>../../build/bin/net10.0/MonoDevelop.Avalonia.Addons.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>