{
  "identity": {
    "id": "MonoDevelop.Gettext",
    "displayName": "Gettext",
    "name": "Gettext",
    "publisher": "MonoDevelop",
    "version": "9.0.0",
    "description": "Gettext translation and localization tools (Avalonia add-in)."
  },
  "assetType": "Microsoft.VisualStudio.MefComponent",
  "installationTarget": { "id": "MonoDevelop.Avalonia", "version": "9.0" },
  "tags": [ "gettext", "translation", "localization" ],
  "categories": [ "Tools" ],
  "dependencies": [ { "id": "MonoDevelop.Ide", "versionRange": "[9.0,*)" } ],
  "autoLoad": true,
  "extensions": {
    "/MonoDevelop/Ide/Commands": [
      { "id": "MonoDevelop.Gettext.Commands.AddTranslation", "label": "Add Translation...", "icon": "md-gettext-locale" },
      { "id": "MonoDevelop.Gettext.Commands.UpdateTranslations", "label": "Update Translations" },
      { "id": "MonoDevelop.Gettext.Commands.UpdateTranslation", "label": "Update Translation" },
      { "id": "MonoDevelop.Gettext.Commands.ScanForTranslations", "label": "Scan for Translations" }
    ],
    "/MonoDevelop/Ide/ContextMenu/ProjectPad": [
      { "id": "MonoDevelop.Ide.Commands.ViewCommands.Open", "condition": "ItemType=MonoDevelop.Gettext.Translation" },
      { "id": "MonoDevelop.Gettext.Commands.UpdateTranslation", "condition": "ItemType=MonoDevelop.Gettext.Translation" },
      { "id": "MonoDevelop.Gettext.Commands.UpdateTranslations", "condition": "ItemType=MonoDevelop.Gettext.TranslationProject" },
      { "id": "MonoDevelop.Gettext.Commands.AddTranslation", "condition": "ItemType=MonoDevelop.Gettext.TranslationProject" }
    ]
  }
}