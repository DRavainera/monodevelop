<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>MonoDevelop.AvaloniaShell</RootNamespace>
    <AssemblyName>MonoDevelop.AvaloniaShell</AssemblyName>
    <!-- Single unified build tree: the Avalonia shell and the legacy GTK
         MonoDevelop.dll (OutputPath build/bin, staged into build/) live in the
         SAME main/build directory, built together from Main.sln. The
         net10.0-windows build is a plain Exe so it opens a console on Windows
         for diagnostics; the linux build stays WinExe. -->
    <OutputPath>..\..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Per-TFM intermediate paths: both TFMs share OutputPath build/ by design,
         but with a shared obj/DebugLinux/ the parallel inner builds race on the
         Avalonia resources task and the generated AssemblyInfo (AVLN9999/MSB4018
         and a corrupt obj/.../AssemblyInfo.cs). Separate intermediate dirs; the
         output layout stays unified. -->
    <AppendTargetFrameworkToIntermediateOutputPath>true</AppendTargetFrameworkToIntermediateOutputPath>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">Exe</OutputType>
    <!-- Symbols live inside the DLL (embedded): a stray handle on the loose
         obj/Debug/*.pdb was blocking every rebuild (AVLN9999) even with the
         build servers shut down; embedded PDBs avoid the extra file entirely
         and remain fully debuggable in VS/VSCode. -->
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Marks the Avalonia shell when compiling reused MonoDevelop.Ide backend
         sources: GTK-only members of those files are wrapped in #if !AVALONIA_SHELL
         and kept out; non-GTK equivalents live in the same .cs. -->
    <DefineConstants>$(DefineConstants);AVALONIA_SHELL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <!-- WebView for the Help pad: renders Monodoc help pages (file:// or
         http(s)) as web tabs in the editor pad. Avalonia 12 renamed the
         Avalonia.Browser WebView control to the official Avalonia.Controls.WebView
         package (AvaloniaUI OÜ); the 12.x Avalonia.Browser package is the
         "run Avalonia in a browser" kit, not a web view control. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- NuGet.Configuration: real backend for the NuGet > Sources preferences panel
         (Settings/PackageSource). Pinned to 7.9.0 EXPLICITLY: the shared
         $(NuGetVersionNuGet) property is now 7.9.0 as well (unified), but the
         explicit pin keeps the shell's pin stable if the property ever diverges
         again. The shell stages its NuGet 7.9.0 closure into main/build. -->
    <!-- NuGet.Configuration: se referencia el lib/net472 explicitamente (igual que el addin
         MonoDevelop.PackageManagement) en lugar del PackageReference simple, que en una app
         net10.0 resuelve el asset net8.0 (NuGet.* 7.9.0.0). Esa familia net8.0 en la raiz
         colisionaba con los closures de addins (net472, NuGet.* 7.9.0.83) y rompian
         DotNetCore/AspNetCore/Packaging con FileLoadException 0x80131040 (mismas identidad,
         dos versiones). Forzar net472 7.9.0.83 unifica la raiz con el resto (directiva: todo
         a 7.9.0, nada de NET 8.0). ExcludeAssets para que el asset net8.0 no entre al RCLP. -->
    <PackageReference Include="NuGet.Configuration" Version="$(NuGetVersionNuGet)" ExcludeAssets="all" />
    <Reference Include="NuGet.Configuration"><HintPath>$(NuGetPackageRoot)nuget.configuration\$(NuGetVersionNuGet)\lib\net472\NuGet.Configuration.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="NuGet.Common"><HintPath>$(NuGetPackageRoot)nuget.common\$(NuGetVersionNuGet)\lib\net472\NuGet.Common.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="NuGet.Frameworks"><HintPath>$(NuGetPackageRoot)nuget.frameworks\$(NuGetVersionNuGet)\lib\net472\NuGet.Frameworks.dll</HintPath><Private>True</Private></Reference>
    <!-- MVT: la shell outputea a la raiz plana build/ (AppendTargetFrameworkToOutputPath=false)
         y es el proyecto que stagea Microsoft.VisualStudio.Threading ahi: su RCLP lo incluye
         de forma transitiva, resuelto a 15.8.192 (file 15.8.0.0) por el pin de vs-editor-api.
         Sin este pin directo la raiz quedaria con MVT 15.8.0.0 (stale de 2018), que hace fallar
         a los addins que piden 16.10.0.0 (FileLoadException en PropertyPad). Forzar 16.10.56
         para que el graph de la shell resuelva 16.10.0.0 y stagee esa version a la raiz. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="16.10.56" />
    <!-- F# language service (FCS 43.12.403, the .NET 10 era): in-process
          FSharpChecker for completions/hover/go-to-def/find-refs/diagnostics
          on .fs/.fsi/.fsx/.fsscript documents (FSharpLanguageService). The
          legacy fsharpbinding used FCS 31.0.0 against a different API
          surface; 43.12 is the version whose editor-service contract
          (GetDeclarationListInfo, GetSymbolUseAtLocation, synchronous
          per-file results) was probed and verified for this port. Brings
          FSharp.Core 10.1.403 into main/build for both the service and the
          FSI child process to resolve. -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.403" />
    <!-- YAML parser for the legacy syntax-definition loader
         (MonoDevelop.Ide.Editor.Highlighting: Sublime3Format reads the
         .sublime-syntax rule files with YamlDotNet). The GTK build pins the
         signed net45 5.2.1; the shell is net10.0 and restores the modern
         unsigned 15.1.2 (API-compatible for the YamlStream/YamlNode surface
         the parser uses). -->
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
    <!-- Microsoft.Extensions.ObjectPool: MonoDevelop.Core compiles
         StringBuilderCache (used by the syntax-highlighting scope parser,
         StackMatchExpression.Parse) against it. MonoDevelop.Core declares it
         with PrivateAssets="runtime", which keeps the runtime asset OUT of
         this shell's deps.json — so the shell's default AssemblyLoadContext
         cannot resolve the assembly at runtime, even though the physical dll
         is staged in main/build by MonoDevelop.Core's IncludeCopyLocal. The
         dynamic syntax-highlighting paint path (SkTextEditor -> GetEditorTheme
         -> StackMatchExpression.Parse -> StringBuilderCache.Allocate) is the
         first shell code to reach it, and it crashes the process without this.
         A direct PackageReference emits the runtime deps entry the shell's
         ALC needs. Version pinned to the package MonoDevelop.Core references. -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="3.0.0-preview9.19423.4" />
    <AvaloniaResource Include="branding\AboutImage.png" />
    <AvaloniaResource Include="branding\AboutImage@2x.png" />
    <AvaloniaResource Include="branding\welcome-logo.png" />
    <AvaloniaResource Include="branding\welcome-logo@2x.png" />
    <AvaloniaResource Include="branding\welcome-tile.png" />
    <!-- Selawik font family (SIL OFL 1.1 — metric-compatible Segoe UI replacement,
         github.com/microsoft/Selawik release 1.01): embedded as avalonia resources
         under Fonts/ (the EmbeddedFontCollection only scans /Fonts/*.ttf),
         referenced as fonts:MonoDevelop.AvaloniaShell#Selawik. -->
    <AvaloniaResource Include="Fonts\selawk.ttf" />
    <AvaloniaResource Include="Fonts\selawkb.ttf" />
    <AvaloniaResource Include="Fonts\selawksb.ttf" />
    <AvaloniaResource Include="Fonts\selawkl.ttf" />
    <AvaloniaResource Include="Fonts\selawksl.ttf" />
    <!-- Mono.Addins.Gui icons (same resources the legacy GTK dialog loads with
         Gdk.Pixbuf.LoadFromResource): tab icons, tree plugin icon, overlays. -->
    <AvaloniaResource Include="Addins\plugin-32.png" />
    <AvaloniaResource Include="Addins\plugin-avail-32.png" />
    <AvaloniaResource Include="Addins\plugin-22.png" />
    <AvaloniaResource Include="Addins\plugin-update-22.png" />
    <AvaloniaResource Include="Addins\update-16.png" />
    <AvaloniaResource Include="Addins\download-16.png" />
    <AvaloniaResource Include="Addins\installed-overlay-16.png" />
    <AvaloniaResource Include="Addins\update-available-overlay-16.png" />
    <AvaloniaResource Include="Addins\web-search-16.png" />
    <AvaloniaResource Include="branding\welcome-tile@2x.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- MonoDevelop.Core is part of the shell (same unified build tree): the non-GTK
         backend (commands, key bindings, options) lives there. -->
    <ProjectReference Include="..\MonoDevelop.Core\MonoDevelop.Core.csproj" />
    <!-- New Avalonia add-in system (replaces Mono.Addins for this shell; the GTK IDE
         keeps using Mono.Addins). Independent module, no GTK. -->
    <ProjectReference Include="..\MonoDevelop.Ide\MonoDevelop.Avalonia.Addons\MonoDevelop.Avalonia.Addons.csproj" />
    <!-- Roslyn option model: the Text Editor C# formatting panel recomputes the same
         per-language option keys (OptionKey.GetPropertyName) the GTK UI persists. -->
    <ProjectReference Include="..\..\compat\MonoRoslynCompat\MonoRoslynCompat.csproj" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>$(NuGetPackageRoot)microsoft.codeanalysis.workspaces.common/$(NuGetVersionRoslyn)/lib/netstandard2.0/Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Core Roslyn (Microsoft.CodeAnalysis.dll): the legacy document contract
         recompiled for the shell (DocumentLocation <-> LinePosition, ITextDocument
         ApplyTextChanges <-> TextChange) needs the core types that
         Microsoft.CodeAnalysis.Workspaces does not expose on its own. -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(NuGetPackageRoot)microsoft.codeanalysis.common/$(NuGetVersionRoslyn)/lib/netstandard2.0/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- The Xwt Avalonia backend: dialogs/pads built on the Xwt frontend
         render through the same Avalonia/Skia stack as this shell. -->
    <ProjectReference Include="..\..\..\external\xwt\Xwt.Avalonia\Xwt.Avalonia.csproj" />
    <ProjectReference Include="..\..\..\external\xwt\Xwt\Xwt.csproj" />
  </ItemGroup>	<ItemGroup>
		<!-- Integration without duplicates: the shell compiles the Services and
			Controls that LIVE in MonoDevelop.Ide (and the debugger services that
			live in the MonoDevelop.Debugger addin) — single source of truth, no
			Avalonia-only copies. MonoDevelop.Ide.csproj keeps its explicit file
			list (it builds the GTK legacy UI and does not reference Avalonia);
			once its Avalonia surface takes over, these move into its Compile set. -->
		<Compile Include="..\MonoDevelop.Ide\Services\**\*.cs" />
		<Compile Include="..\MonoDevelop.Ide\Controls\**\*.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\WatchService.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\BreakpointService.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\DebugSessionService.cs" />
		<!-- REAL Xwt dialogs running on the Xwt.Avalonia backend: compiled from
			their MonoDevelop.Ide source (single source of truth), no GTK — these
			are the first genuine MonoDevelop dialogs off the GTK stack. -->
		<Compile Include="..\MonoDevelop.Ide\MonoDevelop.Ide.Projects\NewSolutionRunConfigurationDialog.cs" />
	</ItemGroup>
