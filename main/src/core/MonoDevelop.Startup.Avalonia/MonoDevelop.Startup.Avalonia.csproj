<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>MonoDevelop.AvaloniaShell</RootNamespace>
    <AssemblyName>MonoDevelop.AvaloniaShell</AssemblyName>
    <!-- Single unified build tree: the GTK (net10.0) outputs go to build/bin,
         the Avalonia shell stages into build/avalonia so both UIs ship from
         main/build. The net10.0-windows build is a plain Exe so it opens a
         console on Windows for diagnostics; the linux build stays WinExe. -->
    <OutputPath>..\..\..\build\avalonia\</OutputPath>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <AvaloniaResource Include="branding\AboutImage.png" />
    <AvaloniaResource Include="branding\AboutImage@2x.png" />
    <AvaloniaResource Include="branding\welcome-logo.png" />
    <AvaloniaResource Include="branding\welcome-logo@2x.png" />
    <AvaloniaResource Include="branding\welcome-tile.png" />
    <AvaloniaResource Include="branding\welcome-tile@2x.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\external\mono-addins\Mono.Addins\Mono.Addins.csproj" />
    <ProjectReference Include="..\..\..\external\mono-addins\Mono.Addins.Setup\Mono.Addins.Setup.csproj" />
  </ItemGroup>
</Project>
