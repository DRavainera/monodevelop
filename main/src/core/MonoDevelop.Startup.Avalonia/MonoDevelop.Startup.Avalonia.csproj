	<!-- Legacy command catalogs: the *.addin.xml sources (MonoDevelop.Ide core +
	     every add-in) are staged next to the binaries under addinxml/ and loaded
	     at startup by CommandCatalogLoader (CommandService). The GTK build stages
	     its own add-in deployment (main/build/AddIns) and is untouched. -->
	<ItemGroup>
		<Content Include="..\**\*.addin.xml" Exclude="**\obj\**;**\bin\**" Link="addinxml\core\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\addins\**\*.addin.xml" Exclude="**\obj\**;**\bin\**" Link="addinxml\addins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<!-- F# Tutorial template asset (port of the legacy FSharpTutorialProject.xpt
	     Tutorial.fs, F# 10-compatible): the "F# Tutorial" New Solution template
	     copies it into the created project (NewSolutionDialog.ScaffoldFSharpTutorial). -->
	<ItemGroup>
		<Content Include="Assets\Tutorial.fs" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
