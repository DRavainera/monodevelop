<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>MonoDevelop.AvaloniaShell</RootNamespace>
    <AssemblyName>MonoDevelop.AvaloniaShell</AssemblyName>
    <!-- Single unified build tree: the Avalonia shell and the legacy GTK
         MonoDevelop.dll (OutputPath build/bin, staged into build/) live in the
         SAME main/build directory, built together from Main.sln. The
         net10.0-windows build is a plain Exe so it opens a console on Windows
         for diagnostics; the linux build stays WinExe. -->
    <OutputPath>..\..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">Exe</OutputType>
    <!-- Symbols live inside the DLL (embedded): a stray handle on the loose
         obj/Debug/*.pdb was blocking every rebuild (AVLN9999) even with the
         build servers shut down; embedded PDBs avoid the extra file entirely
         and remain fully debuggable in VS/VSCode. -->
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Marks the Avalonia shell when compiling reused MonoDevelop.Ide backend
         sources: GTK-only members of those files are wrapped in #if !AVALONIA_SHELL
         and kept out; non-GTK equivalents live in the same .cs. -->
    <DefineConstants>$(DefineConstants);AVALONIA_SHELL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <AvaloniaResource Include="branding\AboutImage.png" />
    <AvaloniaResource Include="branding\AboutImage@2x.png" />
    <AvaloniaResource Include="branding\welcome-logo.png" />
    <AvaloniaResource Include="branding\welcome-logo@2x.png" />
    <AvaloniaResource Include="branding\welcome-tile.png" />
    <!-- Selawik font family (SIL OFL 1.1 — metric-compatible Segoe UI replacement,
         github.com/microsoft/Selawik release 1.01): embedded as avalonia resources
         under Fonts/ (the EmbeddedFontCollection only scans /Fonts/*.ttf),
         referenced as fonts:MonoDevelop.AvaloniaShell#Selawik. -->
    <AvaloniaResource Include="Fonts\selawk.ttf" />
    <AvaloniaResource Include="Fonts\selawkb.ttf" />
    <AvaloniaResource Include="Fonts\selawksb.ttf" />
    <AvaloniaResource Include="Fonts\selawkl.ttf" />
    <AvaloniaResource Include="Fonts\selawksl.ttf" />
    <!-- Mono.Addins.Gui icons (same resources the legacy GTK dialog loads with
         Gdk.Pixbuf.LoadFromResource): tab icons, tree plugin icon, overlays. -->
    <AvaloniaResource Include="Addins\plugin-32.png" />
    <AvaloniaResource Include="Addins\plugin-avail-32.png" />
    <AvaloniaResource Include="Addins\plugin-22.png" />
    <AvaloniaResource Include="Addins\plugin-update-22.png" />
    <AvaloniaResource Include="Addins\update-16.png" />
    <AvaloniaResource Include="Addins\download-16.png" />
    <AvaloniaResource Include="Addins\installed-overlay-16.png" />
    <AvaloniaResource Include="Addins\update-available-overlay-16.png" />
    <AvaloniaResource Include="Addins\web-search-16.png" />
    <AvaloniaResource Include="branding\welcome-tile@2x.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\external\mono-addins\Mono.Addins\Mono.Addins.csproj" />
    <ProjectReference Include="..\..\..\external\mono-addins\Mono.Addins.Setup\Mono.Addins.Setup.csproj" />
    <!-- MonoDevelop.Core is part of the shell (same unified build tree): the non-GTK
         backend (commands, key bindings, options) lives there. -->
    <ProjectReference Include="..\MonoDevelop.Core\MonoDevelop.Core.csproj" />
    <!-- The Xwt Avalonia backend: dialogs/pads built on the Xwt frontend
         render through the same Avalonia/Skia stack as this shell. -->
    <ProjectReference Include="..\..\..\external\xwt\Xwt.Avalonia\Xwt.Avalonia.csproj" />
    <ProjectReference Include="..\..\..\external\xwt\Xwt\Xwt.csproj" />
  </ItemGroup>	<ItemGroup>
		<!-- Integration without duplicates: the shell compiles the Services and
			Controls that LIVE in MonoDevelop.Ide (and the debugger services that
			live in the MonoDevelop.Debugger addin) — single source of truth, no
			Avalonia-only copies. MonoDevelop.Ide.csproj keeps its explicit file
			list (it builds the GTK legacy UI and does not reference Avalonia);
			once its Avalonia surface takes over, these move into its Compile set. -->
		<Compile Include="..\MonoDevelop.Ide\Services\**\*.cs" />
		<Compile Include="..\MonoDevelop.Ide\Controls\**\*.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\WatchService.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\BreakpointService.cs" />
		<Compile Include="..\..\addins\MonoDevelop.Debugger\DebugSessionService.cs" />
		<!-- REAL Xwt dialogs running on the Xwt.Avalonia backend: compiled from
			their MonoDevelop.Ide source (single source of truth), no GTK — these
			are the first genuine MonoDevelop dialogs off the GTK stack. -->
		<Compile Include="..\MonoDevelop.Ide\MonoDevelop.Ide.Projects\NewSolutionRunConfigurationDialog.cs" />
	</ItemGroup>
</Project>
