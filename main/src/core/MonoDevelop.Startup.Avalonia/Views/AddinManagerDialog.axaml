<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MonoDevelop.AvaloniaShell.Views"
        x:Class="MonoDevelop.AvaloniaShell.Views.AddinManagerDialog"
        Title="Add-in Manager"
        Width="860" Height="600"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IdeWindowBgBrush}">

  <Window.Styles>
    <!-- Tab headers styled as plain toggle-ish labels -->
    <Style Selector="ListBox.addintabs ListBoxItem">
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IdeTabActiveBrush}"/>
      </Style>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Custom Avalonia chrome row (same as About/Preferences): dialog title + close -->
    <Border Grid.Row="0" Background="{DynamicResource IdeChromeBgBrush}"
            BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid x:Name="ChromeGrid" ColumnDefinitions="*,Auto">
        <TextBlock Text="Add-in Manager" Margin="12,6" FontWeight="SemiBold"
                   Foreground="{DynamicResource IdeFgBrush}" />
        <Button Grid.Column="1" Classes="caption captionclose" Content="&#x2715;" Click="OnCloseClicked" />
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <!-- Tab row -->
      <ListBox x:Name="TabList" Grid.Row="0" Classes="addintabs" SelectionMode="Single,Toggle"
               SelectionChanged="OnTabSelected" Margin="12,10,12,0" Background="Transparent">
        <ListBoxItem Tag="installed" IsSelected="True"><TextBlock Text="Installed"/></ListBoxItem>
        <ListBoxItem Tag="updates"><TextBlock Text="Updates"/></ListBoxItem>
        <ListBoxItem Tag="gallery"><TextBlock Text="Gallery"/></ListBoxItem>
        <ListBoxItem IsEnabled="False">
          <TextBlock x:Name="TabCountLabel" Text="" Foreground="{DynamicResource IdeFgBrush}" Opacity="0.7"/>
        </ListBoxItem>
      </ListBox>

      <!-- Filter row -->
      <TextBox x:Name="FilterBox" Grid.Row="1" Watermark="Filter add-ins" Margin="12,8,12,4"/>

      <!-- List + details -->
      <Grid Grid.Row="2" ColumnDefinitions="2*,*" Margin="12,4,12,0">
        <ListBox x:Name="AddinList" Grid.Column="0" SelectionChanged="OnAddinSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:AddinItem">
              <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource IdeFgBrush}"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource IdeFgBrush}" Opacity="0.65" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
          <StackPanel x:Name="DetailsPanel" Spacing="6">
            <TextBlock x:Name="DetailsName" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource IdeFgBrush}"/>
            <TextBlock x:Name="DetailsVersion" Opacity="0.8" Foreground="{DynamicResource IdeFgBrush}"/>
            <TextBlock x:Name="DetailsAuthor" Opacity="0.8" Foreground="{DynamicResource IdeFgBrush}"/>
            <TextBlock x:Name="DetailsDesc" TextWrapping="Wrap" Foreground="{DynamicResource IdeFgBrush}"/>
            <CheckBox x:Name="EnableCheck" Content="Enabled" IsCheckedChanged="OnEnableToggled"/>
            <Button x:Name="UninstallButton" Content="Uninstall" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Bottom action bar -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="12,8">
      <Button x:Name="InstallFromFileButton" Content="Install from file..." Width="130"/>
      <Button x:Name="RefreshButton" Content="Refresh" Width="90"/>
      <Button x:Name="CloseButton" Content="Close" Width="90" Click="OnCloseClicked"/>
    </StackPanel>
  </Grid>
</Window>
