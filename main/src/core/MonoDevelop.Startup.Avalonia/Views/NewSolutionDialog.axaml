<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonoDevelop.AvaloniaShell.Views.NewSolutionDialog"
        Title="Create a New Solution"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IdeWindowBgBrush}">

  <!-- Panel design mirrors NewFileDialog: bordered panes with grid splitters
       (categories | templates | title + description), then the Solution name,
       Location (+ Browse) and options rows, and the Create/Cancel action row. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Avalonia chrome -->
    <Border Grid.Row="0" Classes="dialogchrome" Background="{DynamicResource IdeChromeBgBrush}"
            BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="New Solution" Margin="12,6" FontWeight="SemiBold"
                   Foreground="{DynamicResource IdeFgBrush}" />
        <Button Grid.Column="1" Classes="caption captionclose" Content="&#x2715;" Click="OnCancel" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="8,8,8,0" RowDefinitions="*,Auto,Auto,Auto"
          ColumnDefinitions="170,3,240,3,*">
      <!-- Categories -->
      <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,6"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1">
        <ListBox x:Name="CategoryList" Background="Transparent"
                 Foreground="{DynamicResource IdeFgBrush}" SelectionChanged="OnCategorySelected">
          <ListBoxItem Content="C#" IsSelected="True" />
          <ListBoxItem Content="F#" IsEnabled="False" />
          <ListBoxItem Content="Other" IsEnabled="False" />
        </ListBox>
      </Border>
      <GridSplitter Grid.Row="0" Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" Background="Transparent" />

      <!-- Templates (32px icons like the legacy DND list) -->
      <Border Grid.Row="0" Grid.Column="2" Margin="0,0,6,0"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1">
        <ListBox x:Name="TemplateList" Background="Transparent"
                 Foreground="{DynamicResource IdeFgBrush}" SelectionChanged="OnTemplateSelected">
          <ListBoxItem Tag="console">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image x:Name="IconConsole" Width="32" Height="32" />
              <TextBlock Text="Console Application" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="library">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image x:Name="IconLibrary" Width="32" Height="32" />
              <TextBlock Text="Class Library" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="unittest">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image x:Name="IconTest" Width="32" Height="32" />
              <TextBlock Text="Unit Test Project" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="shared">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image x:Name="IconShared" Width="32" Height="32" />
              <TextBlock Text="Shared Project" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>
      <GridSplitter Grid.Row="0" Grid.Column="3" Width="3" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" Background="Transparent" />

      <!-- Info pane (same as New File: bold title + wrapping description) -->
      <Border Grid.Row="0" Grid.Column="4" Padding="6"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1">
        <DockPanel>
          <TextBlock x:Name="TemplateTitle" DockPanel.Dock="Top" FontWeight="Bold"
                     TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource IdeFgBrush}" />
          <TextBlock x:Name="TemplateDescription" TextWrapping="Wrap" Opacity="0.85"
                     Foreground="{DynamicResource IdeFgBrush}" />
        </DockPanel>
      </Border>

      <!-- Solution name row -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="Solution name:" VerticalAlignment="Center"
                   Foreground="{DynamicResource IdeFgBrush}" />
        <TextBox x:Name="SolutionName" Width="320" Text="Solution" />
      </StackPanel>

      <!-- Location row with folder browse (legacy FolderEntry "...") -->
      <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="Location:" VerticalAlignment="Center"
                   Foreground="{DynamicResource IdeFgBrush}" />
        <TextBox x:Name="LocationBox" Width="460" />
        <Button x:Name="BrowseButton" Content="Browse" Click="OnBrowseLocation" MinWidth="64" />
      </StackPanel>

      <!-- Options (legacy checkbox block) -->
      <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Spacing="6" Margin="0,8,0,0">
        <CheckBox x:Name="CreateDirectoryCheck" Content="Create a directory for the solution"
                  IsChecked="True" Foreground="{DynamicResource IdeFgBrush}" />
        <CheckBox x:Name="AddToSolutionCheck" Content="Add to open solution"
                  Foreground="{DynamicResource IdeFgBrush}" />
        <CheckBox x:Name="GitCheck" Content="Use git for version control"
                  Foreground="{DynamicResource IdeFgBrush}" />
      </StackPanel>
    </Grid>

    <!-- OK/Cancel -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10">
      <Button x:Name="CreateButton" Content="Create" Click="OnCreate" Width="88" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="OnCancel" Width="88" />
    </StackPanel>
  </Grid>
</Window>
