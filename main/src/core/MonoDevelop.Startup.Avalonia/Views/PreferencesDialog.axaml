<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonoDevelop.AvaloniaShell.Views.PreferencesDialog"
        Title="Preferences"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IdeWindowBgBrush}">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
      <Setter Property="Background" Value="{DynamicResource IdeChromeBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Custom chrome (Avalonia border like the rest of the migrated dialogs) -->
    <Border Grid.Row="0" Classes="dialogchrome" Background="{DynamicResource IdeChromeBgBrush}"
            BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Preferences" Margin="12,6" FontWeight="SemiBold" />
        <Button Grid.Column="1" Classes="caption captionclose" Content="&#x2715;" Click="OnCancel" />
      </Grid>
    </Border>

    <!-- Category tree | panel with header (legacy OptionsDialog layout: TreeView column
         + icon/title header + panel page). The tree is built in code from the
         GlobalOptionsDialog.addin.xml section order plus the add-in extensions. -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*">
      <TreeView x:Name="SectionTree" Margin="8" SelectionChanged="OnSectionSelected" />

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <StackPanel x:Name="PanelHeader" Grid.Row="0" Orientation="Horizontal" Spacing="10"
                    Margin="16,14,16,8">
          <Image x:Name="HeaderIcon" Width="28" Height="28" VerticalAlignment="Center" />
          <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1"
                Margin="12,0,12,4" />

        <ScrollViewer Grid.Row="2" Margin="8,0,8,8">
          <Panel>

            <!-- ===== Visual Style (legacy IDEStyleOptionsPanel: theme + language +
                 restart in one panel) ===== -->
            <StackPanel x:Name="PanelStyle" Margin="16" Spacing="10" IsVisible="False">
              <TextBlock Text="User Interface Theme" FontWeight="SemiBold" />
              <RadioButton x:Name="ThemeSystemRadio" GroupName="uitheme" Content="System" />
              <RadioButton x:Name="ThemeDarkRadio" GroupName="uitheme" Content="Dark" />
              <RadioButton x:Name="ThemeLightRadio" GroupName="uitheme" Content="Light" />
              <TextBlock Text="System follows the operating system light/dark setting. The legacy GTK dialog listed the installed GTK themes; the new UI maps them to the Fluent variants."
                         TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
              <TextBlock Text="User Interface Language" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ComboBox x:Name="LanguageCombo" MinWidth="260" HorizontalAlignment="Left" />
              <TextBlock x:Name="LanguageRestartNote"
                         Text="These preferences will take effect next time you start MonoDevelop"
                         TextWrapping="Wrap" Opacity="0.8" />
              <StackPanel x:Name="LanguageRestartRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
                <Button x:Name="LanguageRestartButton" Content="Restart MonoDevelop" Click="OnRestartClicked" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Author Information (legacy GlobalAuthorInformationPanel; keys
                 Author.Name / Author.Email / Author.Copyright / Author.Company / Author.Trademark) ===== -->
            <StackPanel x:Name="PanelAuthor" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Name" Opacity="0.8" />
              <TextBox x:Name="AuthName" />
              <TextBlock Text="Email" Opacity="0.8" />
              <TextBox x:Name="AuthEmail" />
              <TextBlock Text="Copyright" Opacity="0.8" />
              <TextBox x:Name="AuthCopyright" />
              <TextBlock Text="Company" Opacity="0.8" />
              <TextBox x:Name="AuthCompany" />
              <TextBlock Text="Trademark" Opacity="0.8" />
              <TextBox x:Name="AuthTrademark" />
            </StackPanel>

            <!-- ===== Key Bindings (legacy KeyBindingsPanel: scheme "current" editable in
                 Custom.kb.xml. Select command, capture accelerator, Update/Add.) ===== -->
            <Grid x:Name="PanelKeyBindings" Margin="16"
                  RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" IsVisible="False">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Scheme:" VerticalAlignment="Center" />
                <ComboBox x:Name="KbSchemeCombo" MinWidth="220" SelectionChanged="OnKbSchemeChanged" />
              </StackPanel>
              <Separator Grid.Row="1" Margin="0,6" />
              <TextBox x:Name="KbSearch" Grid.Row="2" Width="260" HorizontalAlignment="Left"
                       Watermark="Search" TextChanged="OnKbSearchChanged" />
              <Border x:Name="KbWarningBox" Grid.Row="3" IsVisible="False" Margin="0,6"
                      BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image x:Name="KbWarningIcon" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock Text="The current scheme has conflicting key bindings" VerticalAlignment="Center" />
                  <Button x:Name="KbConflictsButton" Content="View Conflicts" Click="OnKbViewConflicts" />
                </StackPanel>
              </Border>
              <TreeView x:Name="KbTree" Grid.Row="4" SelectionChanged="OnKbTreeSelectionChanged" />
              <TextBlock x:Name="KbMessage" Grid.Row="5" IsVisible="False" TextWrapping="Wrap" Margin="0,4,0,0" />
              <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="Edit Binding" VerticalAlignment="Center" />
                <TextBox x:Name="KbAccelEntry" Width="220" KeyDown="OnKbAccelKeyDown" />
                <Button x:Name="KbApplyBtn" Content="Apply" Click="OnKbUpdate" />
                <Button x:Name="KbAddBtn" Content="Add" Click="OnKbAddRemove" />
              </StackPanel>
            </Grid>

            <!-- ===== Fonts (legacy FontsPanel: FontProperties nested property with
                 Editor / Pad / OutputPad roles, "Family Size" specs) ===== -->
            <StackPanel x:Name="PanelFonts" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Text Editor" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontEditorCombo" MinWidth="240" />
                  <TextBox x:Name="FontEditorSize" Width="52" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Pad" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontPadCombo" MinWidth="240" />
                  <TextBox x:Name="FontPadSize" Width="52" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Output Pad" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontOutputCombo" MinWidth="240" />
                  <TextBox x:Name="FontOutputSize" Width="52" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="FontApplyBtn" Content="Apply to open editors" Click="OnFontApply" />
                <Button x:Name="FontResetBtn" Content="Reset to defaults" Click="OnFontReset" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11"
                         Text="Stored as FontProperties (nested) in MonoDevelopProperties.xml, same keys as the GTK UI." />
            </StackPanel>

            <!-- ===== Updates (legacy AddInsOptionsPanel: check for updates) ===== -->
            <StackPanel x:Name="PanelUpdates" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="UpdatesCheck" Content="Automatically check for updates"
                        IsChecked="True" />
            </StackPanel>

            <!-- ===== Tasks (legacy TasksOptionsPanel: user task priority colors) ===== -->
            <StackPanel x:Name="PanelTasks" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Colors for user-defined tasks, as #RRGGBB." Opacity="0.8" />
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="High priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskHighEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Normal priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskNormalEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Low priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskLowEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
            </StackPanel>

            <!-- ===== External Tools (legacy MonoDevelop-tools.xml editor) ===== -->
            <Grid x:Name="PanelExternalTools" Margin="16" RowDefinitions="Auto,*,Auto"
                  ColumnDefinitions="*,160" IsVisible="False">
              <ListBox x:Name="ToolsList" Grid.Row="0" Grid.ColumnSpan="2" MinHeight="140" MaxHeight="180" />
              <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="6" Margin="0,8,0,0">
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Menu Command" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolMenuCommand" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Command" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolCommand" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Arguments" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolArguments" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Initial Directory" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolInitialDirectory" Grid.Column="1" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <Button Content="Add" Click="OnToolAdd" />
                  <Button Content="Remove" Click="OnToolRemove" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- ===== Feedback (legacy LogAgentOptionsPanel: report errors + usage) ===== -->
            <StackPanel x:Name="PanelFeedback" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="FbReportCheck"
                        Content="Report errors and usage information to help MonoDevelop improve my experience." />
            </StackPanel>

            <!-- ===== Load/Save (legacy LoadSavePanel) ===== -->
            <StackPanel x:Name="PanelLoadSave" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="Default project directory" VerticalAlignment="Center" />
                <TextBox x:Name="LsDefaultPath" Grid.Column="1" />
              </Grid>
              <CheckBox x:Name="LsLoadUserProps" Content="Load previous user properties when opening documents" />
              <CheckBox x:Name="LsBackupCopies" Content="Create backup copies of files before saving" />
              <TextBlock Text="On startup" FontWeight="SemiBold" Margin="0,8,0,0" />
              <RadioButton x:Name="LsStartupStart" GroupName="startup" Content="Show start window" />
              <RadioButton x:Name="LsStartupPrev" GroupName="startup" Content="Load previous solution" />
              <RadioButton x:Name="LsStartupEmpty" GroupName="startup" Content="Empty environment" />
            </StackPanel>

            <!-- ===== Build (legacy BuildPanel) ===== -->
            <StackPanel x:Name="PanelBuild" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="200,*">
                <TextBlock Text="Before compiling" VerticalAlignment="Center" />
                <ComboBox x:Name="BldBeforeCompileCombo" Grid.Column="1" MinWidth="180"
                          HorizontalAlignment="Left">
                  <ComboBoxItem Content="Do nothing" />
                  <ComboBoxItem Content="Save all files" />
                  <ComboBoxItem Content="Prompt to save" />
                </ComboBox>
              </Grid>
              <CheckBox x:Name="BldRunWithWarnings" Content="Run even when there are warnings" />
              <CheckBox x:Name="BldBuildBeforeExec" Content="Build before executing" />
              <CheckBox x:Name="BldBuildBeforeTests" Content="Build before running tests" />
              <CheckBox x:Name="BldSkipUnmodified" Content="Skip building unmodified projects" />
              <CheckBox x:Name="BldParallel" Content="Build multiple projects in parallel" />
              <Grid ColumnDefinitions="200,*" Margin="0,4,0,0">
                <TextBlock Text="MSBuild verbosity" VerticalAlignment="Center" />
                <ComboBox x:Name="BldVerbosityCombo" Grid.Column="1" MinWidth="180"
                          HorizontalAlignment="Left">
                  <ComboBoxItem Content="Quiet" />
                  <ComboBoxItem Content="Minimal" />
                  <ComboBoxItem Content="Normal" />
                  <ComboBoxItem Content="Detailed" />
                  <ComboBoxItem Content="Diagnostic" />
                </ComboBox>
              </Grid>
            </StackPanel>

            <!-- ===== Errors and Warnings (legacy BuildMessagePanel, sub-panel of Build) ===== -->
            <StackPanel x:Name="PanelBuildMessages" Margin="16" Spacing="10" IsVisible="False">
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Jump to first" VerticalAlignment="Center" />
                <ComboBox x:Name="BmJumpCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Error" />
                  <ComboBoxItem Content="Error or Warning" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Show error pad after build" VerticalAlignment="Center" />
                <ComboBox x:Name="BmErrorPadCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Always" />
                  <ComboBoxItem Content="On Errors" />
                  <ComboBoxItem Content="On Errors or Warnings" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Message bubbles" VerticalAlignment="Center" />
                <ComboBox x:Name="BmBubblesCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="For Errors" />
                  <ComboBoxItem Content="For Errors and Warnings" />
                </ComboBox>
              </Grid>
            </StackPanel>

            <!-- ===== Maintenance (legacy MaintenanceOptionsPanel) ===== -->
            <StackPanel x:Name="PanelMaintenance" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="MtInstrumentation" Content="Enable instrumentation" />
              <CheckBox x:Name="MtAutomatedTesting" Content="Enable automated testing" />
            </StackPanel>

            <!-- ===== Text Editor → General (legacy SourceEditor2 GeneralOptionsPanel) ===== -->
            <StackPanel x:Name="PanelGeneral" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Line endings" VerticalAlignment="Center" />
                <ComboBox x:Name="GenLineEndingsCombo" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Always ask for conversion" />
                  <ComboBoxItem Content="Leave line endings as is" />
                  <ComboBoxItem Content="Always convert line endings" />
                </ComboBox>
              </Grid>
              <TextBlock Text="Margin and folding" FontWeight="SemiBold" Margin="0,6,0,0" />
              <CheckBox x:Name="GenShowFoldMargin" Content="Show folding margin" />
              <CheckBox x:Name="GenDefaultRegionsFolding" Content="Fold regions by default" />
              <CheckBox x:Name="GenDefaultCommentFolding" Content="Fold comments by default" />
              <TextBlock Text="Word wrap" FontWeight="SemiBold" Margin="0,6,0,0" />
              <CheckBox x:Name="GenWordWrap" Content="Word wrap" />
              <CheckBox x:Name="GenWordWrapGlyphs" Content="Show visible glyphs for word wrap" Margin="16,0,0,0" />
            </StackPanel>

            <!-- ===== Text Editor → Markers and Rulers (legacy MarkerPanel) ===== -->
            <StackPanel x:Name="PanelMarkers" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="MkShowLineNumbers" Content="Show line numbers" />
              <CheckBox x:Name="MkShowRuler" Content="Show column ruler" />
              <CheckBox x:Name="MkHighlightCurrentLine" Content="Highlight current line" />
              <CheckBox x:Name="MkHighlightMatchingBracket" Content="Highlight matching brackets" />
              <CheckBox x:Name="MkHighlightUsages" Content="Highlight identifier references" />
              <CheckBox x:Name="MkDrawIndentMarkers" Content="Draw indentation markers" />
              <CheckBox x:Name="MkEnableQuickDiff" Content="Highlight changed lines" />
              <CheckBox x:Name="MkProcedureSeparators" Content="Show procedure line separators" />
              <CheckBox x:Name="MkEnableAnimations" Content="Enable animations in the text editor" />
              <Grid ColumnDefinitions="240,*" Margin="0,6,0,0">
                <TextBlock Text="Show invisible characters" VerticalAlignment="Center" />
                <ComboBox x:Name="MkShowWhitespacesCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Never" />
                  <ComboBoxItem Content="Selection" />
                  <ComboBoxItem Content="Always" />
                </ComboBox>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="MkIncludeSpaces" Content="Spaces" />
                <CheckBox x:Name="MkIncludeTabs" Content="Tabs" />
                <CheckBox x:Name="MkIncludeLineEndings" Content="Line endings" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Text Editor → Behavior (legacy BehaviorPanel) ===== -->
            <StackPanel x:Name="PanelBehavior" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Indentation mode" VerticalAlignment="Center" />
                <ComboBox x:Name="BhIndentCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="Automatic" />
                  <ComboBoxItem Content="Smart" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Word break mode" VerticalAlignment="Center" />
                <ComboBox x:Name="BhWordNavigationCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Unix" />
                  <ComboBoxItem Content="Windows" />
                </ComboBox>
              </Grid>
              <CheckBox x:Name="BhAutoInsertBrace" Content="Automatically insert braces" />
              <CheckBox x:Name="BhSmartSemicolon" Content="Smart semicolon placement" Margin="16,0,0,0" />
              <CheckBox x:Name="BhTabAsReindent" Content="Tab key reindents the selection" />
              <CheckBox x:Name="BhSmartBackspace" Content="Backspace removes indentation" />
              <CheckBox x:Name="BhFormatOnSave" Content="Reformat document when saving" />
              <CheckBox x:Name="BhAutoPatternCasing" Content="Automatically set search pattern case sensitivity" />
              <CheckBox x:Name="BhSelectionSurrounding" Content="Enable selection surrounding keys" />
              <CheckBox x:Name="BhFormattingUndo" Content="Add an undo step for formatting changes" />
            </StackPanel>

            <!-- ===== Text Editor → IntelliSense (legacy CompletionOptionsPanel) ===== -->
            <StackPanel x:Name="PanelIntelliSense" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="IsAutoCodeCompletion" Content="Enable automatic code completion" />
              <CheckBox x:Name="IsShowImports" Content="Show items from unimported namespaces" Margin="16,0,0,0" />
              <CheckBox x:Name="IsIncludeKeywords" Content="Include keywords in the completion list" />
              <CheckBox x:Name="IsIncludeSnippets" Content="Include code snippets in the completion list" />
              <CheckBox x:Name="IsSuggestionMode" Content="Use suggestion mode (do not commit on typing)" />
            </StackPanel>

            <!-- ===== Text Editor → Color Theme (legacy HighlightingPanel) ===== -->
            <Grid x:Name="PanelColorTheme" Margin="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,130" IsVisible="False">
              <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Available color themes" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="ThemeList" Grid.Row="1" MinHeight="260" MaxHeight="340" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="10,0,0,0">
                <Button Content="Add…" Click="OnThemeAdd" />
                <Button Content="Remove" Click="OnThemeRemove" />
                <Button Content="Open folder" Click="OnThemeOpenFolder" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as ColorScheme (light) / ColorScheme-Dark (dark) in MonoDevelopProperties.xml, same keys as the GTK UI. User themes live in the ColorThemes folder." />
            </Grid>

            <!-- ===== Text Editor → Code Snippets (legacy CodeTemplatePane) ===== -->
            <Grid x:Name="PanelCodeSnippets" Margin="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="280,*" IsVisible="False">
              <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Code snippets" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="SnippetList" Grid.Row="1" SelectionChanged="OnSnippetSelected" />
              <TextBox x:Name="SnippetPreview" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="NoWrap" />
              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Remove" Click="OnSnippetRemove" />
              </StackPanel>
            </Grid>

            <!-- ===== Text Editor → Language Bundles (legacy TextMateBundleOptionsPanel) ===== -->
            <Grid x:Name="PanelLanguageBundles" Margin="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,130" IsVisible="False">
              <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Installed language bundles" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="BundleList" Grid.Row="1" MinHeight="260" MaxHeight="340" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="10,0,0,0">
                <Button Content="Add…" Click="OnBundleAdd" />
                <Button Content="Remove" Click="OnBundleRemove" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="User bundles live in the LanguageBundles folder; built-in bundles are provided by the IDE." />
            </Grid>

            <!-- ===== Source Code → .NET Naming Policies (legacy NamespaceSynchronisationPanel) ===== -->
            <StackPanel x:Name="PanelNaming" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="NmAssociate" Content="Associate namespaces with directory names" />
              <CheckBox x:Name="NmDefaultRoot" Content="Use the default namespace as the root of all namespaces" Margin="16,0,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="20" Margin="16,0,0,0">
                <RadioButton x:Name="NmFlat" GroupName="nspolicy" Content="Flat folder structure" />
                <RadioButton x:Name="NmHierarch" GroupName="nspolicy" Content="Hierarchical folder structure" />
              </StackPanel>
              <Grid ColumnDefinitions="200,*" Margin="0,6,0,0">
                <TextBlock Text="Resource naming" VerticalAlignment="Center" />
                <ComboBox x:Name="NmResourceCombo" Grid.Column="1" MinWidth="240" HorizontalAlignment="Left">
                  <ComboBoxItem Content="File format default" />
                  <ComboBoxItem Content="File name" />
                  <ComboBoxItem Content="Visual Studio style (MSBuild)" />
                </ComboBox>
              </Grid>
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as the DotNetNamingPolicy entry of the global policy set (Policies/UserDefault.mdpolicy.xml), same as the GTK UI." />
            </StackPanel>

            <!-- ===== Source Code → Standard Header (legacy StandardHeaderPolicyPanel) ===== -->
            <StackPanel x:Name="PanelStandardHeader" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="ShInclude" Content="Include the standard header in newly created files" />
              <TextBlock Text="Header text" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBox x:Name="ShText" AcceptsReturn="True" Height="170" TextWrapping="NoWrap" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as the StandardHeader entry of the global policy set (Policies/UserDefault.mdpolicy.xml), same as the GTK UI." />
            </StackPanel>

            <!-- ===== Version Control → ChangeLog Integration (legacy ProjectOptionPanel) ===== -->
            <StackPanel x:Name="PanelChangeLog" Margin="16" Spacing="5" IsVisible="False">
              <TextBlock Text="ChangeLog update mode" FontWeight="SemiBold" />
              <RadioButton x:Name="ClModeNone" GroupName="clmode" Content="Do not generate ChangeLog entries" />
              <RadioButton x:Name="ClModeNearest" GroupName="clmode" Content="Use the nearest ChangeLog file" />
              <RadioButton x:Name="ClModeProjectRoot" GroupName="clmode" Content="One ChangeLog in the project root directory" />
              <RadioButton x:Name="ClModeDirectory" GroupName="clmode" Content="One ChangeLog in each directory" />
              <CheckBox x:Name="ClIntegrate" Content="Integrate with version control" Margin="0,6,0,0" />
              <CheckBox x:Name="ClRequireOnCommit" Content="Require ChangeLog entries for all files when committing" Margin="16,0,0,0" />
              <TextBlock Text="Message header" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBox x:Name="ClHeader" />
              <CheckBox x:Name="ClUseBullets" Content="Use bullets for each entry" />
              <CheckBox x:Name="ClIndentEntries" Content="Indent each entry" />
              <CheckBox x:Name="ClIndent" Content="Align the message text" />
              <CheckBox x:Name="ClLineSep" Content="Add a blank line between messages" />
              <CheckBox x:Name="ClOneLine" Content="Add one line per file changed" />
              <CheckBox x:Name="ClMsgNewLine" Content="Keep the file name and messages on separate lines" />
              <CheckBox x:Name="ClIncludeDirs" Content="Include file directories" />
              <CheckBox x:Name="ClWrap" Content="Wrap the lines at 60 characters" />
              <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Border BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6">
                <TextBlock x:Name="ClPreview" TextWrapping="Wrap" FontSize="11" />
              </Border>
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as the ChangeLogPolicy entry of the global policy set, same as the GTK UI." />
            </StackPanel>

            <!-- ===== NuGet → Sources (legacy PackageSourcesOptionsPanel) ===== -->
            <Grid x:Name="PanelNugetSources" Margin="16" RowDefinitions="Auto,*,Auto" IsVisible="False">
              <TextBlock Grid.Row="0" Text="Package sources" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="NugetSourceList" Grid.Row="1" MinHeight="220" MaxHeight="300"
                       SelectionChanged="OnNugetSourceSelected" />
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                <Grid ColumnDefinitions="120,*,Auto">
                  <TextBox x:Name="NugetSourceName" Watermark="Name" />
                  <TextBox x:Name="NugetSourceUrl" Grid.Column="1" Margin="6,0,0,0" Watermark="Source URL" />
                  <Button Grid.Column="2" Content="Add" Margin="6,0,0,0" Click="OnNugetSourceAdd" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Remove" Click="OnNugetSourceRemove" />
                  <Button Content="Move Up" Click="OnNugetSourceUp" />
                  <Button Content="Move Down" Click="OnNugetSourceDown" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.8" x:Name="NugetSourceInfo" />
                </StackPanel>
                <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                           Text="Reads/writes NuGet.Config through NuGet.Configuration Settings (same backend as the GTK UI)." />
              </StackPanel>
            </Grid>

            <!-- ===== Text Editor → Source Analysis (legacy AnalysisOptionsPanel) ===== -->
            <StackPanel x:Name="PanelAnalysis" Margin="16" Spacing="6" IsVisible="False">
              <CheckBox x:Name="AnOpenFiles" Content="Enable source analysis of open files" />
              <CheckBox x:Name="AnWholeSolution" Content="Enable source analysis of whole solution" IsEnabled="False" />
              <CheckBox x:Name="AnUnitTest" Content="Enable text editor unit test integration" />
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the legacy keys MonoDevelop.AnalysisCore.AnalysisEnabled_V2 and Testing.EnableUnitTestEditorIntegration. 'Whole solution' depends on a Roslyn per-language option key and stays disabled until the Roslyn reference is wired." />
            </StackPanel>

            <!-- ===== Text Editor → Behavior → C# (legacy OnTheFlyFormattingPanel) ===== -->
            <StackPanel x:Name="PanelCSharpFormat" Margin="16" Spacing="6" IsVisible="False">
              <CheckBox x:Name="CsFormatOnType" Content="Automatically format when typing" />
              <CheckBox x:Name="CsFormatOnSemicolon" Content="Automatically format statement on ;" Margin="16,0,0,0" />
              <CheckBox x:Name="CsFormatOnCloseBrace" Content="Automatically format block on }" Margin="16,0,0,0" />
              <CheckBox x:Name="CsFormatOnReturn" Content="Automatically format on return" />
              <CheckBox x:Name="CsFormatOnPaste" Content="Automatically format on paste" />
              <CheckBox x:Name="CsShowFilterButtons" Content="Show completion item filters" />
              <CheckBox x:Name="CsTriggerOnDeletion" Content="Show completion list after a character is deleted" />
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the same Roslyn per-language keys the GTK UI computes via OptionKey.GetPropertyName()." />
            </StackPanel>

            <!-- ===== Text Editor → Behavior → XML (legacy XmlEditorOptionsPanel) ===== -->
            <StackPanel x:Name="PanelXmlEditor" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="XmlAutoComplete" Content="Automatically complete elements" />
              <CheckBox x:Name="XmlAutoInsertFragments" Content="Automatically insert closing fragments" />
              <CheckBox x:Name="XmlShowSchema" Content="Show schema annotations" />
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as nested properties under XmlEditor.AddIn.Options, same as the GTK UI." />
            </StackPanel>

            <!-- ===== Text Editor → IntelliSense → Appearance (legacy CompletionAppearancePanel) ===== -->
            <StackPanel x:Name="PanelCompletionAppearance" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="CompletionFilterBrowsable" Content="Filter the completion list by browsable members" />
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the legacy CompletionOptionsHideAdvancedMembers key." />
            </StackPanel>

            <StackPanel x:Name="PanelPerfDiag" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Output directory:" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                  <TextBox x:Name="PerfDiagPath" Watermark="~/Desktop" />
                  <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnPerfDiagBrowse" />
                </Grid>
              </Grid>
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the legacy PerformanceDiagnosticsAddIn.OutputPath key." />
            </StackPanel>

            <StackPanel x:Name="PanelRuntimes" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock x:Name="RuntimeRunning" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ListBox x:Name="RuntimesList" MinHeight="160" MaxHeight="260" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Lists the runtimes registered by the runtime service; the default is stored with the legacy MonoDevelop.Ide.DefaultTargetRuntime key." />
            </StackPanel>

            <!-- ===== Projects → SDK Locations → .NET Core (legacy DotNetCoreSdkLocationPanel) ===== -->
            <StackPanel x:Name="PanelNetCore" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Microsoft .NET Core SDK location" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="NetCorePath" Watermark="/usr/bin/dotnet" />
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnNetCoreBrowse" />
              </Grid>
              <TextBlock Text="Installed runtimes" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock x:Name="NetCoreRuntimes" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as DotNetCoreRuntimeFileName (same key as the GTK UI); changing it re-evaluates open .NET Core projects." />
            </StackPanel>

            <StackPanel x:Name="PanelDebugger" Margin="16" Spacing="6" IsVisible="False">
              <TextBlock Text="Scope" FontWeight="SemiBold" />
              <CheckBox x:Name="DbStepOverProps" Content="Step over properties and operators" />
              <CheckBox x:Name="DbStepIntoExternal" Content="Step into external code" />
              <TextBlock Margin="16,0,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                         Text="The debugger will step into code and hit exceptions in dependencies that aren't considered part of your project, like packages and references." />
              <TextBlock Text="Evaluation" FontWeight="SemiBold" Margin="0,8,0,0" />
              <CheckBox x:Name="DbAllowEval" Content="Allow implicit property evaluation and method invocation" />
              <CheckBox x:Name="DbAllowToString" Content="Call string-conversion function on objects in variables windows" Margin="16,0,0,0" />
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Evaluation timeout (ms)" VerticalAlignment="Center" />
                <TextBox x:Name="DbTimeout" Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left" />
              </Grid>
              <CheckBox x:Name="DbShowBaseGroup" Content="Show inherited class members in a base class group" />
              <CheckBox x:Name="DbGroupPrivate" Content="Group non-public members in the Variables windows" />
              <CheckBox x:Name="DbGroupStatic" Content="Group static members in the Variables windows" />
              <Grid ColumnDefinitions="220,*" Margin="0,6,0,0">
                <TextBlock Text="Automatic source download" VerticalAlignment="Center" />
                <ComboBox x:Name="DbSourceDownload" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Ask" />
                  <ComboBoxItem Content="Always" />
                  <ComboBoxItem Content="Never" />
                </ComboBox>
              </Grid>
              <TextBlock Text="Advanced options" FontWeight="SemiBold" Margin="0,8,0,0" />
              <CheckBox x:Name="DbLogging" Content="Enable some diagnostic logging" />
              <CheckBox x:Name="DbUseNewTreeView" Content="Use the new variables tree view" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the legacy MonoDevelop.Debugger.DebuggingService.* keys in MonoDevelopProperties.xml." />
            </StackPanel>

            <StackPanel x:Name="PanelNugetGeneral" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Package Restore" FontWeight="SemiBold" />
              <CheckBox x:Name="NugetRestore" Content="Automatically restore packages when opening a solution." />
              <TextBlock Text="Package Updates" FontWeight="SemiBold" Margin="0,6,0,0" />
              <CheckBox x:Name="NugetUpdates" Content="Check for package updates when opening a solution." />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as nested properties under PackageManagementSettings in MonoDevelopProperties.xml, same as the GTK UI." />
            </StackPanel>

            <StackPanel x:Name="PanelGit" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="GitRebase" Content="Use the Rebase option for merging" />
              <CheckBox x:Name="GitStashUpdate" Content="Automatically stash/unstash local changes" />
              <CheckBox x:Name="GitStashBranch" Content="Automatically stash/unstash changes when switching branches" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored with the legacy keys MonoDevelop.VersionControl.Git.* in MonoDevelopProperties.xml." />
            </StackPanel>

            <StackPanel x:Name="PanelCommitMessage" Margin="16" Spacing="6" IsVisible="False">
              <TextBlock Text="Message header" FontWeight="SemiBold" />
              <TextBox x:Name="CmHeader" Watermark="(none)" />
              <CheckBox x:Name="CmUseBullets" Content="Use bullets for each entry" />
              <CheckBox x:Name="CmIndentEntries" Content="Indent each entry" />
              <CheckBox x:Name="CmIndent" Content="Align the message text" />
              <CheckBox x:Name="CmLineSep" Content="Add a blank line between messages" />
              <CheckBox x:Name="CmOneLine" Content="Add one line per file changed" />
              <CheckBox x:Name="CmMsgNewLine" Content="Keep the file name and messages on separate lines" />
              <CheckBox x:Name="CmIncludeDirs" Content="Include file directories" />
              <CheckBox x:Name="CmWrap" Content="Wrap the lines at 60 characters" />
              <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Border BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6">
                <TextBlock x:Name="CmPreview" TextWrapping="Wrap" FontSize="11" />
              </Border>
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as the VersionControlPolicy entry of the global policy set, same as the GTK UI." />
            </StackPanel>

            <StackPanel x:Name="PanelCodeFormatting" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Text file formatting" FontWeight="SemiBold" />
              <RadioButton x:Name="CfIndentSpaces" GroupName="cfindent" Content="Indent with spaces" />
              <RadioButton x:Name="CfIndentTabs" GroupName="cfindent" Content="Indent with tabs" />
              <Grid ColumnDefinitions="200,*">
                <TextBlock Text="Indent width" VerticalAlignment="Center" />
                <TextBox x:Name="CfIndentWidth" Grid.Column="1" MaxWidth="100" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="200,*">
                <TextBlock Text="Tab width" VerticalAlignment="Center" />
                <TextBox x:Name="CfTabWidth" Grid.Column="1" MaxWidth="100" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="200,*">
                <TextBlock Text="File width (ruler column)" VerticalAlignment="Center" />
                <TextBox x:Name="CfFileWidth" Grid.Column="1" MaxWidth="100" HorizontalAlignment="Left" />
              </Grid>
              <CheckBox x:Name="CfRemoveTrailing" Content="Remove trailing whitespace" />
              <CheckBox x:Name="CfNoTabsAfterNonTabs" Content="No tabs after non-tab characters" />
              <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored as the TextStylePolicy entry of the global policy set (same keys as the GTK UI). The per-MimeType policy-set selection tree needs the add-in engine." />
            </StackPanel>

            <Grid x:Name="PanelXmlSchemas" Margin="16" RowDefinitions="Auto,*,Auto" IsVisible="False">
              <TextBlock Grid.Row="0" Text="User XML schemas" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox x:Name="XmlSchemasList" Grid.Row="1" MinHeight="140" MaxHeight="220" />
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Add…" Click="OnXmlSchemaAdd" />
                  <Button Content="Remove" Click="OnXmlSchemaRemove" />
                </StackPanel>
                <TextBlock Text="File extensions bound to XML schemas" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBox x:Name="XmlSchemaAssociations" IsReadOnly="True" AcceptsReturn="True" MinHeight="110"
                         TextWrapping="NoWrap" FontSize="11" />
                <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                           Text="Schemas live in XmlSchemas under the MonoDevelop data folder; extensions are stored as Association* properties under XmlEditor.AddIn.Options (same as the GTK UI)." />
              </StackPanel>
            </Grid>

            <StackPanel x:Name="PanelVcGeneral" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="VcDisableCheck" Content="Disable Version Control globally" />
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                         Text="Stored in VersionControl.config (same file the GTK UI reads; repositories are preserved)." />
            </StackPanel>

            <StackPanel x:Name="PanelPlaceholder" Margin="16" IsVisible="False" Spacing="8">
              <TextBlock Text="This options panel is provided by an add-in and has not been wired to the new UI yet."
                         TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- OK/Cancel (OK = ApplyChanges, like OptionsDialog) -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10">
      <Button Content="OK" Click="OnOk" Width="88" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="OnCancel" Width="88" />
    </StackPanel>
  </Grid>
</Window>
