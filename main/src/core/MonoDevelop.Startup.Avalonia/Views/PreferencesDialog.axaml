<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonoDevelop.AvaloniaShell.Views.PreferencesDialog"
        Title="Preferences"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IdeWindowBgBrush}">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Custom chrome -->
    <Border Grid.Row="0" Background="{DynamicResource IdeChromeBgBrush}"
            BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Preferences" Margin="12,6" FontWeight="SemiBold"
                   Foreground="{DynamicResource IdeFgBrush}" />
        <Button Grid.Column="1" Classes="caption captionclose" Content="&#x2715;" Click="OnCancel" />
      </Grid>
    </Border>

    <!-- Section tree + panel -->
    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <ListBox x:Name="SectionList" Margin="8" Background="Transparent"
               Foreground="{DynamicResource IdeFgBrush}" SelectionChanged="OnSectionSelected">
        <ListBoxItem Content="Environment" IsEnabled="False" FontWeight="Bold" />
        <ListBoxItem Tag="style">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconStyle" />
            <TextBlock Text="Visual Style" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="language">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconLanguage" />
            <TextBlock Text="User Interface Language" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="author">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconAuthor" />
            <TextBlock Text="Author Information" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="keybindings">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconKeyBindings" />
            <TextBlock Text="Key Bindings" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="fonts">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconFonts" />
            <TextBlock Text="Fonts" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="updates">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconUpdates" />
            <TextBlock Text="Updates" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="tasks">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconTasks" />
            <TextBlock Text="Tasks" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="externaltools">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconExternalTools" />
            <TextBlock Text="External Tools" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Content="Projects" IsEnabled="False" FontWeight="Bold" />
        <ListBoxItem Tag="loadsave">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconLoadSave" />
            <TextBlock Text="Load/Save" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="build">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconBuild" />
            <TextBlock Text="Build" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="sdklocations">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconSdkLocations" />
            <TextBlock Text="SDK Locations" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Content="Text Editor" IsEnabled="False" FontWeight="Bold" />
        <ListBoxItem Tag="formatting">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconFormatting" />
            <TextBlock Text="Formatting" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="codesnippets">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconCodeSnippets" />
            <TextBlock Text="Code Snippets" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="languagebundles">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconLanguageBundles" />
            <TextBlock Text="Language Bundles" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Content="Source Code" IsEnabled="False" FontWeight="Bold" />
        <ListBoxItem Tag="naming">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconNaming" />
            <TextBlock Text=".NET Naming Policies" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="codeformatting">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconCodeFormatting" />
            <TextBlock Text="Code Formatting" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="standardheader">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Width="16" Height="16" x:Name="IconStandardHeader" />
            <TextBlock Text="Standard Header" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Content="Version Control" IsEnabled="False" FontWeight="Bold" />
        <ListBoxItem Content="Other" IsEnabled="False" FontWeight="Bold" />
      </ListBox>

      <ScrollViewer Grid.Column="1" Margin="8" BorderBrush="{DynamicResource IdeBorderBrush}"
                    BorderThickness="1,1,0,0">
        <Panel>
          <!-- Visual Style panel (functional): theme switching wired to the shell -->
          <StackPanel x:Name="PanelStyle" Margin="16" Spacing="10">
            <TextBlock Text="User Interface Theme" FontWeight="SemiBold" Foreground="{DynamicResource IdeFgBrush}" />
            <RadioButton x:Name="ThemeDarkRadio" GroupName="uitheme" Content="Dark"
                         Foreground="{DynamicResource IdeFgBrush}" />
            <RadioButton x:Name="ThemeLightRadio" GroupName="uitheme" Content="Light"
                         Foreground="{DynamicResource IdeFgBrush}" />
          </StackPanel>

          <!-- User Interface Language panel (legacy parity: LocalizationService locales,
               selection stored like IdeApp.Preferences.UserInterfaceLanguage; takes effect
               on restart, as announced by the note below). -->
          <StackPanel x:Name="PanelLanguage" Margin="16" Spacing="10" IsVisible="False">
            <TextBlock Text="User Interface Language" FontWeight="SemiBold" Foreground="{DynamicResource IdeFgBrush}" />
            <ComboBox x:Name="LanguageCombo" MinWidth="260"
                      Foreground="{DynamicResource IdeFgBrush}" />
            <TextBlock x:Name="LanguageRestartNote"
                       Text="These preferences will take effect next time you start MonoDevelop"
                       TextWrapping="Wrap" Opacity="0.8" Foreground="{DynamicResource IdeFgBrush}" />
            <StackPanel x:Name="LanguageRestartRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
              <Button x:Name="LanguageRestartButton" Content="Restart MonoDevelop" Click="OnRestartClicked" />
            </StackPanel>
          </StackPanel>

          <!-- Generic placeholder for panels not ported yet -->
          <StackPanel x:Name="PanelPlaceholder" Margin="16" IsVisible="False" Spacing="8">
            <TextBlock x:Name="PlaceholderTitle" FontWeight="SemiBold" Foreground="{DynamicResource IdeFgBrush}" />
            <TextBlock Text="This options panel has not been ported to the new UI yet. Its settings remain available through the legacy interface until the cutover."
                       TextWrapping="Wrap" Foreground="{DynamicResource IdeFgBrush}" Opacity="0.7" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>

    <!-- OK/Cancel -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10">
      <Button Content="OK" Click="OnOk" Width="88" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="OnCancel" Width="88" />
    </StackPanel>
  </Grid>
</Window>
