<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonoDevelop.AvaloniaShell.Views.PreferencesDialog"
        Title="Preferences"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IdeWindowBgBrush}">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
      <Setter Property="Background" Value="{DynamicResource IdeChromeBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource IdeFgBrush}" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Custom chrome (Avalonia border like the rest of the migrated dialogs) -->
    <Border Grid.Row="0" Classes="dialogchrome" Background="{DynamicResource IdeChromeBgBrush}"
            BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Preferences" Margin="12,6" FontWeight="SemiBold" />
        <Button Grid.Column="1" Classes="caption captionclose" Content="&#x2715;" Click="OnCancel" />
      </Grid>
    </Border>

    <!-- Category tree | panel with header (legacy OptionsDialog layout: TreeView column
         + icon/title header + panel page). The tree is built in code from the
         GlobalOptionsDialog.addin.xml section order plus the add-in extensions. -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*">
      <TreeView x:Name="SectionTree" Margin="8" SelectionChanged="OnSectionSelected" />

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <StackPanel x:Name="PanelHeader" Grid.Row="0" Orientation="Horizontal" Spacing="10"
                    Margin="16,14,16,8">
          <Image x:Name="HeaderIcon" Width="28" Height="28" VerticalAlignment="Center" />
          <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,0,1"
                Margin="12,0,12,4" />

        <ScrollViewer Grid.Row="2" Margin="8,0,8,8">
          <Panel>

            <!-- ===== Visual Style (legacy IDEStyleOptionsPanel: theme + language +
                 restart in one panel) ===== -->
            <StackPanel x:Name="PanelStyle" Margin="16" Spacing="10" IsVisible="False">
              <TextBlock Text="User Interface Theme" FontWeight="SemiBold" />
              <RadioButton x:Name="ThemeDarkRadio" GroupName="uitheme" Content="Dark" />
              <RadioButton x:Name="ThemeLightRadio" GroupName="uitheme" Content="Light" />
              <TextBlock Text="The legacy GTK dialog listed the installed GTK themes; the new UI maps them to the Fluent dark/light variants."
                         TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
              <TextBlock Text="User Interface Language" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ComboBox x:Name="LanguageCombo" MinWidth="260" HorizontalAlignment="Left" />
              <TextBlock x:Name="LanguageRestartNote"
                         Text="These preferences will take effect next time you start MonoDevelop"
                         TextWrapping="Wrap" Opacity="0.8" />
              <StackPanel x:Name="LanguageRestartRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
                <Button x:Name="LanguageRestartButton" Content="Restart MonoDevelop" Click="OnRestartClicked" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Author Information (legacy GlobalAuthorInformationPanel; keys
                 Author.Name / Author.Email / Author.Copyright / Author.Company / Author.Trademark) ===== -->
            <StackPanel x:Name="PanelAuthor" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Name" Opacity="0.8" />
              <TextBox x:Name="AuthName" />
              <TextBlock Text="Email" Opacity="0.8" />
              <TextBox x:Name="AuthEmail" />
              <TextBlock Text="Copyright" Opacity="0.8" />
              <TextBox x:Name="AuthCopyright" />
              <TextBlock Text="Company" Opacity="0.8" />
              <TextBox x:Name="AuthCompany" />
              <TextBlock Text="Trademark" Opacity="0.8" />
              <TextBox x:Name="AuthTrademark" />
            </StackPanel>

            <!-- ===== Key Bindings (legacy KeyBindingsPanel: scheme "current" editable in
                 Custom.kb.xml. Select command, capture accelerator, Update/Add.) ===== -->
            <Grid x:Name="PanelKeyBindings" Margin="16" RowDefinitions="Auto,*,Auto,Auto"
                  ColumnDefinitions="*,160" IsVisible="False">
              <ListBox x:Name="KbCommandsList" Grid.Row="0" Grid.ColumnSpan="2" MinHeight="220"
                       MaxHeight="300" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Accelerator:" VerticalAlignment="Center" />
                <TextBox x:Name="KbAccelEntry" Width="180" KeyDown="OnKbAccelKeyDown"
                         Watermark="Press keys…" />
                <Button x:Name="KbUpdateBtn" Content="Update" Click="OnKbUpdate" />
                <Button x:Name="KbRemoveBtn" Content="Remove" Click="OnKbRemove" />
              </StackPanel>
              <TextBlock x:Name="KbHint" Grid.Row="2" Margin="0,6,0,0" Opacity="0.7" FontSize="11"
                         Text="Overrides are stored in KeyBindings/Custom.kb.xml (legacy scheme 'current'). Press Enter in the box to capture a key combination." />
            </Grid>

            <!-- ===== Fonts (legacy FontsPanel: FontProperties nested property with
                 Editor / Pad / OutputPad roles, "Family Size" specs) ===== -->
            <StackPanel x:Name="PanelFonts" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Text Editor" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontEditorCombo" MinWidth="240" />
                  <TextBox x:Name="FontEditorSize" Width="52" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Pad" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontPadCombo" MinWidth="240" />
                  <TextBox x:Name="FontPadSize" Width="52" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Text="Output Pad" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="FontOutputCombo" MinWidth="240" />
                  <TextBox x:Name="FontOutputSize" Width="52" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="FontApplyBtn" Content="Apply to open editors" Click="OnFontApply" />
                <Button x:Name="FontResetBtn" Content="Reset to defaults" Click="OnFontReset" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="11"
                         Text="Stored as FontProperties (nested) in MonoDevelopProperties.xml, same keys as the GTK UI." />
            </StackPanel>

            <!-- ===== Updates (legacy AddInsOptionsPanel: check for updates) ===== -->
            <StackPanel x:Name="PanelUpdates" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="UpdatesCheck" Content="Automatically check for updates"
                        IsChecked="True" />
            </StackPanel>

            <!-- ===== Tasks (legacy TasksOptionsPanel: user task priority colors) ===== -->
            <StackPanel x:Name="PanelTasks" Margin="16" Spacing="8" IsVisible="False">
              <TextBlock Text="Colors for user-defined tasks, as #RRGGBB." Opacity="0.8" />
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="High priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskHighEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Normal priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskNormalEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Low priority" VerticalAlignment="Center" />
                <TextBox x:Name="TaskLowEntry" Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" />
              </Grid>
            </StackPanel>

            <!-- ===== External Tools (legacy MonoDevelop-tools.xml editor) ===== -->
            <Grid x:Name="PanelExternalTools" Margin="16" RowDefinitions="Auto,*,Auto"
                  ColumnDefinitions="*,160" IsVisible="False">
              <ListBox x:Name="ToolsList" Grid.Row="0" Grid.ColumnSpan="2" MinHeight="140" MaxHeight="180" />
              <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="6" Margin="0,8,0,0">
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Menu Command" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolMenuCommand" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Command" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolCommand" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Arguments" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolArguments" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="130,*">
                  <TextBlock Text="Initial Directory" VerticalAlignment="Center" />
                  <TextBox x:Name="ToolInitialDirectory" Grid.Column="1" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <Button Content="Add" Click="OnToolAdd" />
                  <Button Content="Remove" Click="OnToolRemove" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- ===== Feedback (legacy LogAgentOptionsPanel: report errors + usage) ===== -->
            <StackPanel x:Name="PanelFeedback" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="FbReportCheck"
                        Content="Report errors and usage information to help MonoDevelop improve my experience." />
            </StackPanel>

            <!-- ===== Load/Save (legacy LoadSavePanel) ===== -->
            <StackPanel x:Name="PanelLoadSave" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="180,*">
                <TextBlock Text="Default project directory" VerticalAlignment="Center" />
                <TextBox x:Name="LsDefaultPath" Grid.Column="1" />
              </Grid>
              <CheckBox x:Name="LsLoadUserProps" Content="Load previous user properties when opening documents" />
              <CheckBox x:Name="LsBackupCopies" Content="Create backup copies of files before saving" />
              <TextBlock Text="On startup" FontWeight="SemiBold" Margin="0,8,0,0" />
              <RadioButton x:Name="LsStartupStart" GroupName="startup" Content="Show start window" />
              <RadioButton x:Name="LsStartupPrev" GroupName="startup" Content="Load previous solution" />
              <RadioButton x:Name="LsStartupEmpty" GroupName="startup" Content="Empty environment" />
            </StackPanel>

            <!-- ===== Build (legacy BuildPanel) ===== -->
            <StackPanel x:Name="PanelBuild" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="200,*">
                <TextBlock Text="Before compiling" VerticalAlignment="Center" />
                <ComboBox x:Name="BldBeforeCompileCombo" Grid.Column="1" MinWidth="180"
                          HorizontalAlignment="Left">
                  <ComboBoxItem Content="Do nothing" />
                  <ComboBoxItem Content="Save all files" />
                  <ComboBoxItem Content="Prompt to save" />
                </ComboBox>
              </Grid>
              <CheckBox x:Name="BldRunWithWarnings" Content="Run even when there are warnings" />
              <CheckBox x:Name="BldBuildBeforeExec" Content="Build before executing" />
              <CheckBox x:Name="BldBuildBeforeTests" Content="Build before running tests" />
              <CheckBox x:Name="BldSkipUnmodified" Content="Skip building unmodified projects" />
              <CheckBox x:Name="BldParallel" Content="Build multiple projects in parallel" />
              <Grid ColumnDefinitions="200,*" Margin="0,4,0,0">
                <TextBlock Text="MSBuild verbosity" VerticalAlignment="Center" />
                <ComboBox x:Name="BldVerbosityCombo" Grid.Column="1" MinWidth="180"
                          HorizontalAlignment="Left">
                  <ComboBoxItem Content="Quiet" />
                  <ComboBoxItem Content="Minimal" />
                  <ComboBoxItem Content="Normal" />
                  <ComboBoxItem Content="Detailed" />
                  <ComboBoxItem Content="Diagnostic" />
                </ComboBox>
              </Grid>
            </StackPanel>

            <!-- ===== Errors and Warnings (legacy BuildMessagePanel, sub-panel of Build) ===== -->
            <StackPanel x:Name="PanelBuildMessages" Margin="16" Spacing="10" IsVisible="False">
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Jump to first" VerticalAlignment="Center" />
                <ComboBox x:Name="BmJumpCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Error" />
                  <ComboBoxItem Content="Error or Warning" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Show error pad after build" VerticalAlignment="Center" />
                <ComboBox x:Name="BmErrorPadCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Always" />
                  <ComboBoxItem Content="On Errors" />
                  <ComboBoxItem Content="On Errors or Warnings" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="220,*">
                <TextBlock Text="Message bubbles" VerticalAlignment="Center" />
                <ComboBox x:Name="BmBubblesCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left">
                  <ComboBoxItem Content="For Errors" />
                  <ComboBoxItem Content="For Errors and Warnings" />
                </ComboBox>
              </Grid>
            </StackPanel>

            <!-- ===== Maintenance (legacy MaintenanceOptionsPanel) ===== -->
            <StackPanel x:Name="PanelMaintenance" Margin="16" Spacing="10" IsVisible="False">
              <CheckBox x:Name="MtInstrumentation" Content="Enable instrumentation" />
              <CheckBox x:Name="MtAutomatedTesting" Content="Enable automated testing" />
            </StackPanel>

            <!-- ===== Text Editor → General (legacy SourceEditor2 GeneralOptionsPanel) ===== -->
            <StackPanel x:Name="PanelGeneral" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Line endings" VerticalAlignment="Center" />
                <ComboBox x:Name="GenLineEndingsCombo" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Always ask for conversion" />
                  <ComboBoxItem Content="Leave line endings as is" />
                  <ComboBoxItem Content="Always convert line endings" />
                </ComboBox>
              </Grid>
              <TextBlock Text="Margin and folding" FontWeight="SemiBold" Margin="0,6,0,0" />
              <CheckBox x:Name="GenShowFoldMargin" Content="Show folding margin" />
              <CheckBox x:Name="GenDefaultRegionsFolding" Content="Fold regions by default" />
              <CheckBox x:Name="GenDefaultCommentFolding" Content="Fold comments by default" />
              <TextBlock Text="Word wrap" FontWeight="SemiBold" Margin="0,6,0,0" />
              <CheckBox x:Name="GenWordWrap" Content="Word wrap" />
              <CheckBox x:Name="GenWordWrapGlyphs" Content="Show visible glyphs for word wrap" Margin="16,0,0,0" />
            </StackPanel>

            <!-- ===== Text Editor → Markers and Rulers (legacy MarkerPanel) ===== -->
            <StackPanel x:Name="PanelMarkers" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="MkShowLineNumbers" Content="Show line numbers" />
              <CheckBox x:Name="MkShowRuler" Content="Show column ruler" />
              <CheckBox x:Name="MkHighlightCurrentLine" Content="Highlight current line" />
              <CheckBox x:Name="MkHighlightMatchingBracket" Content="Highlight matching brackets" />
              <CheckBox x:Name="MkHighlightUsages" Content="Highlight identifier references" />
              <CheckBox x:Name="MkDrawIndentMarkers" Content="Draw indentation markers" />
              <CheckBox x:Name="MkEnableQuickDiff" Content="Highlight changed lines" />
              <CheckBox x:Name="MkProcedureSeparators" Content="Show procedure line separators" />
              <CheckBox x:Name="MkEnableAnimations" Content="Enable animations in the text editor" />
              <Grid ColumnDefinitions="240,*" Margin="0,6,0,0">
                <TextBlock Text="Show invisible characters" VerticalAlignment="Center" />
                <ComboBox x:Name="MkShowWhitespacesCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Never" />
                  <ComboBoxItem Content="Selection" />
                  <ComboBoxItem Content="Always" />
                </ComboBox>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="MkIncludeSpaces" Content="Spaces" />
                <CheckBox x:Name="MkIncludeTabs" Content="Tabs" />
                <CheckBox x:Name="MkIncludeLineEndings" Content="Line endings" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Text Editor → Behavior (legacy BehaviorPanel) ===== -->
            <StackPanel x:Name="PanelBehavior" Margin="16" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Indentation mode" VerticalAlignment="Center" />
                <ComboBox x:Name="BhIndentCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="Automatic" />
                  <ComboBoxItem Content="Smart" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="240,*">
                <TextBlock Text="Word break mode" VerticalAlignment="Center" />
                <ComboBox x:Name="BhWordNavigationCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Unix" />
                  <ComboBoxItem Content="Windows" />
                </ComboBox>
              </Grid>
              <CheckBox x:Name="BhAutoInsertBrace" Content="Automatically insert braces" />
              <CheckBox x:Name="BhSmartSemicolon" Content="Smart semicolon placement" Margin="16,0,0,0" />
              <CheckBox x:Name="BhTabAsReindent" Content="Tab key reindents the selection" />
              <CheckBox x:Name="BhSmartBackspace" Content="Backspace removes indentation" />
              <CheckBox x:Name="BhFormatOnSave" Content="Reformat document when saving" />
              <CheckBox x:Name="BhAutoPatternCasing" Content="Automatically set search pattern case sensitivity" />
              <CheckBox x:Name="BhSelectionSurrounding" Content="Enable selection surrounding keys" />
              <CheckBox x:Name="BhFormattingUndo" Content="Add an undo step for formatting changes" />
            </StackPanel>

            <!-- ===== Text Editor → IntelliSense (legacy CompletionOptionsPanel) ===== -->
            <StackPanel x:Name="PanelIntelliSense" Margin="16" Spacing="8" IsVisible="False">
              <CheckBox x:Name="IsAutoCodeCompletion" Content="Enable automatic code completion" />
              <CheckBox x:Name="IsShowImports" Content="Show items from unimported namespaces" Margin="16,0,0,0" />
              <CheckBox x:Name="IsIncludeKeywords" Content="Include keywords in the completion list" />
              <CheckBox x:Name="IsIncludeSnippets" Content="Include code snippets in the completion list" />
              <CheckBox x:Name="IsSuggestionMode" Content="Use suggestion mode (do not commit on typing)" />
            </StackPanel>

            <!-- Generic placeholder for panels provided by add-ins that are not wired
                 in this shell (their settings remain available through the legacy UI). -->
            <StackPanel x:Name="PanelPlaceholder" Margin="16" IsVisible="False" Spacing="8">
              <TextBlock Text="This options panel is provided by an add-in and has not been wired to the new UI yet. Its settings remain available through the legacy interface until the cutover."
                         TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- OK/Cancel (OK = ApplyChanges, like OptionsDialog) -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10">
      <Button Content="OK" Click="OnOk" Width="88" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="OnCancel" Width="88" />
    </StackPanel>
  </Grid>
</Window>
