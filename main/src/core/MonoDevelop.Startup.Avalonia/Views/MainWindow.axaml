<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MonoDevelop.AvaloniaShell.Controls"
        x:Class="MonoDevelop.AvaloniaShell.Views.MainWindow"
        Title="MonoDevelop — Avalonia Shell"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None">

  <DockPanel>
    <!-- Title bar row: menu bar + caption buttons (no OS title bar) -->
    <Panel x:Name="TitleBarRow" DockPanel.Dock="Top" Background="{DynamicResource IdeChromeBgBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Full legacy main menu (structure/labels/icons of MainMenu.addin.xml + addins),
             built by MenuService/MenuBuilder. -->
        <Menu x:Name="MainMenu" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="CaptionButtons">
          <Button Classes="caption" Content="&#x2013;" Click="OnMinimize" />
          <Button Classes="caption" Content="&#x25A1;" Click="OnMaximize" />
          <Button Classes="caption captionclose" Content="&#x2715;" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Panel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="6,3" Background="{DynamicResource IdeChromeBgBrush}">
      <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="{DynamicResource IdeFgBrush}" />
    </Border>

    <!-- Tool panes + document area -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Left: Solution pad -->
      <Border x:Name="SolutionPane" Grid.Row="0" Grid.Column="0" Width="260"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,1,0"
              Background="{DynamicResource IdeWindowBgBrush}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="8,6" Text="Solution" FontWeight="Bold"
                     Foreground="{DynamicResource IdeFgBrush}" />
          <ListBox x:Name="SolutionList" Background="Transparent" Foreground="{DynamicResource IdeFgBrush}">
            <ListBoxItem Content="Solution 'TestProj' (1 project)" />
            <ListBoxItem Content="└ TestProj" />
            <ListBoxItem Content="  └ References" />
            <ListBoxItem Content="  └ Program.cs" />
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Documents area: island tabs -->
      <Border x:Name="DocumentPane" Grid.Row="0" Grid.Column="1"
              Background="{DynamicResource IdeWindowBgBrush}"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,0,1,0">
        <TabControl x:Name="DocTabs" TabStripPlacement="Top">
          <TabItem Classes="island" Header="Program.cs">
            <controls:SkTextEditor Text="public class Program { }"
                                   FontSize="13"
                                   Foreground="{DynamicResource IdeFgBrush}"
                                   GutterBackground="{DynamicResource IdeChromeBgBrush}"
                                   GutterForeground="{DynamicResource IdeFgBrush}"
                                   CaretBrush="{DynamicResource IdeFgBrush}" />
          </TabItem>
          <TabItem Classes="island" Header="global.json">
            <TextBox AcceptsReturn="True" Text="{}{ &quot;sdk&quot;: { } }"
                     FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="13"
                     Background="Transparent" Foreground="{DynamicResource IdeFgBrush}" />
          </TabItem>
        </TabControl>
      </Border>

      <!-- Right: properties pad (placeholder) -->
      <Border x:Name="PropertiesPane" Grid.Row="0" Grid.Column="2" Width="220"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0"
              Background="{DynamicResource IdeWindowBgBrush}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="8,6" Text="Properties" FontWeight="Bold"
                     Foreground="{DynamicResource IdeFgBrush}" />
          <TextBlock Text="(placeholder)" Padding="8" Foreground="{DynamicResource IdeFgBrush}" Opacity="0.5" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="1" Width="3" HorizontalAlignment="Left"
                    Background="Transparent" ResizeDirection="Columns" />
      <GridSplitter Grid.Row="0" Grid.Column="2" Width="3" HorizontalAlignment="Left"
                    Background="Transparent" ResizeDirection="Columns" />

      <!-- Bottom: output pad -->
      <Border x:Name="OutputPane" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="160"
              BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource IdeWindowBgBrush}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="8,4" Text="Output" FontWeight="Bold"
                     Foreground="{DynamicResource IdeFgBrush}" />
          <TextBox x:Name="OutputText" AcceptsReturn="True" IsReadOnly="True"
                   Text="[shell] Avalonia 12.1.2 console ready." FontSize="12"
                   Padding="8" Background="Transparent" Foreground="{DynamicResource IdeFgBrush}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
