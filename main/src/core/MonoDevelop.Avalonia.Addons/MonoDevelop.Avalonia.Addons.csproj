<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MonoDevelop.Avalonia.Addons</RootNamespace>
    <AssemblyName>MonoDevelop.Avalonia.Addons</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- Standalone module: NOT referenced from MonoDevelop.Ide (the GTK IDE keeps
         using Mono.Addins). The Avalonia shell references this project. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
</Project>
