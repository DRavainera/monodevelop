<Project>

  <PropertyGroup>
    <ReferencesGtkCopyToOutput Condition="$(ReferencesGtkCopyToOutput) == ''">false</ReferencesGtkCopyToOutput>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="atk-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/atk-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="gdk-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/gdk-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="glade-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/glade-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="glib-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/glib-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="gtk-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/gtk-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="pango-sharp, Version=2.12.0.0, Culture=neutral, PublicKeyToken=35e10195dab3c99f">
      <HintPath>$(MonoGtkSharpDirectory)/pango-sharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
  </ItemGroup>

</Project>