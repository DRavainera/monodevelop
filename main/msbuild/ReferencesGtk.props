<Project>

  <PropertyGroup>
    <ReferencesGtkCopyToOutput Condition="$(ReferencesGtkCopyToOutput) == ''">false</ReferencesGtkCopyToOutput>
    <GtkSharpVersion Condition="'$(GtkSharpVersion)' == ''">3.24.24.95</GtkSharpVersion>
    <GtkSharpLibDir>$(NuGetPackageRoot)gtksharp/$(GtkSharpVersion)/lib/net6.0</GtkSharpLibDir>
    <GtkSharpDepsDir>$(NuGetPackageRoot)</GtkSharpDepsDir>
  </PropertyGroup>

  <!-- SDK-style projects: PackageReference (transitive deps: Atk/Cairo/GLib/Gdk/Gio/Pango) -->
  <ItemGroup Condition=" '$(UsingMicrosoftNETSdk)' == 'true' ">
    <PackageReference Include="GtkSharp" Version="$(GtkSharpVersion)" Private="$(ReferencesGtkCopyToOutput)" />
  </ItemGroup>

  <!-- Legacy (non-SDK) projects: direct references from the NuGet cache -->
  <ItemGroup Condition=" '$(UsingMicrosoftNETSdk)' != 'true' ">
    <Reference Include="GtkSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpLibDir)/GtkSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="AtkSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)atksharp/$(GtkSharpVersion)/lib/net6.0/AtkSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="CairoSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)cairosharp/$(GtkSharpVersion)/lib/net6.0/CairoSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="GLibSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)glibsharp/$(GtkSharpVersion)/lib/net6.0/GLibSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="GdkSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)gdksharp/$(GtkSharpVersion)/lib/net6.0/GdkSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="GioSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)giosharp/$(GtkSharpVersion)/lib/net6.0/GioSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
    <Reference Include="PangoSharp, Version=$(GtkSharpVersion), Culture=neutral">
      <HintPath>$(GtkSharpDepsDir)pangosharp/$(GtkSharpVersion)/lib/net6.0/PangoSharp.dll</HintPath>
      <Private>$(ReferencesGtkCopyToOutput)</Private>
    </Reference>
  </ItemGroup>

</Project>
