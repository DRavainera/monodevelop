<Project>

  <PropertyGroup>
    <RARCoverity Condition="$(COVERITY_GTK) != ''">$(MSBuildThisFileDirectory)\$(COVERITY_GTK)</RARCoverity>
    <RARResolveFromGAC Condition="$(RARResolveFromGAC) == ''">true</RARResolveFromGAC>
    <RARCandidateAssemblyFiles Condition="$(RARResolveFromCandidateAssemblyFiles) == 'true'">{CandidateAssemblyFiles};</RARCandidateAssemblyFiles>
    <RAROutputDirectory Condition="$(RARResolveFromOutputDirectory) == 'true'">$(OutDir)</RAROutputDirectory>
    <RARGAC Condition="$(RARResolveFromGAC) == 'true'">{GAC}</RARGAC>
    <AssemblySearchPaths>{RawFileName};{HintPathFromItem};{TargetFrameworkDirectory};$(RARGAC);$(RAROutputDirectory);$(RARCandidateAssemblyFiles);$(RARCoverity)</AssemblySearchPaths>
    <AllowedReferenceAssemblyFileExtensions>.dll</AllowedReferenceAssemblyFileExtensions>
    <!-- we do have .dll.mdb for Gtk# assemblies, but they're all in the GAC anyway, so effectively we only need .pdb. We don't have .exe.mdb. -->
    <AllowedReferenceRelatedDebugFileExtensions>.pdb</AllowedReferenceRelatedDebugFileExtensions>
    <AllowedReferenceRelatedFileExtensions>.pdb;.xml;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)msbuild\LegacyReferenceAssemblies.targets" />

  <!--
  EnsureLegacyReferenceStaging:

  Este sistema no trae el perfil .NET Framework 4.5 (/usr/lib/mono/4.5 vacio,
  GAC vacio), asi que MonoFrameworkNet45Directory cae a main/build. El pack de
  reference assemblies net472 (NuGet, ya restaurado para otros proyectos del
  arbol) tiene las facades legacy que los proyectos old-style referencian por
  HintPath $(MonoFrameworkNet45Directory)/... (System.Design, System.Web,
  System.Web.Services, System.Windows.Forms, System.Xaml). Se copian a
  main/build (gitignored) para que esas HintPaths resuelvan. Compile-only: los
  proyectos las declaran con Private=false; en tiempo de ejecucion el host
  .NET 10 aporta lo que existe en su BCL.
  -->
  <Target Name="EnsureLegacyReferenceStaging"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(OS)' != 'Windows_NT' AND $([System.IO.Directory]::Exists('$(MSBuildThisFileDirectory)build')) AND $([System.IO.File]::Exists('$(LegacyReferenceAssembliesDir)\System.Design.dll'))">
    <ItemGroup>
      <_LegacyRefName Include="System.Design;System.Web;System.Web.Services;System.Windows.Forms;System.Xaml" />
      <_LegacyRefSrc Include="@(_LegacyRefName->'$(LegacyReferenceAssembliesDir)\%(Identity).dll')" />
      <_LegacyRefDst Include="@(_LegacyRefName->'$(MSBuildThisFileDirectory)build\%(Identity).dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LegacyRefSrc)" DestinationFiles="@(_LegacyRefDst)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="FixWindowsAccessibilityReference"
    AfterTargets="ResolveAssemblyReference"
    BeforeTargets="CoreCompile;FindReferenceAssembliesForReferences"
    Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="%(ReferencePath.OriginalItemSpec) == 'Accessibility'" />
    </ItemGroup>
  </Target>


  <!-- Unified runtime staging: when the build is driven by Main.sln (dotnet build
       Main.sln), stage the GTK runtime (net10run) into main/build after the build
       and keep the freshly built MonoDevelop.dll entrypoint in sync. The staging
       target lives in after.Main.sln.targets and triggers only on the key
       projects (Startup/Startup.Avalonia/Ide) so net472 tool projects that cannot
       build in this setup don't affect it. -->
  <Import Project="$(MSBuildThisFileDirectory)before.Main.sln.targets"
          Condition="'$(IsGraphBuild)' != 'true' and '$(SolutionName)' == 'Main.sln'" />
  <Import Project="$(MSBuildThisFileDirectory)after.Main.sln.targets"
          Condition="'$(SolutionName)' == 'Main.sln'" />
</Project>
